        newLoTime := reversalLoTime
        newHiTime := reversalHiTime
        bool reversalHasFvg = not na(reversalStart)
        if not reversalHasFvg
            // Без встречного FVG разворот идёт от конечного экстремума старого потока.
            newStart := newDir == 1 ? flowLoTime : flowHiTime
            newLo := newDir == 1 ? flowLo : structuralReverseLo
            newHi := newDir == -1 ? flowHi : structuralReverseHi
            newLoTime := newDir == 1 ? flowLoTime : structuralReverseLoTime
            newHiTime := newDir == -1 ? flowHiTime : structuralReverseHiTime
    if newDir != 0
        // Передаём рабочую зону до сброса движений-кандидатов.
        FlowFvg selectedZone = changeRule == 1 ? ruleOneZone : changeRule == 2 ? reversalZone : changeRule == 3 ? continuationZone : initialZone
        // Замораживаем последнее состояние действующего потока перед сменой.
        // Если FVG появился позже выхода тенью, не откатываем уже показанный диапазон.
        int archivedStart = beforeBarStart
        float archivedLo = beforeBarLo
        float archivedHi = beforeBarHi
        string stamp = str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Moscow")
        string explanation = changeRule == 1 ? "№1: пробой первого FVG + противоположный FVG + старшее подтверждение" : changeRule == 4 ? "СТАРТ ПО ПЕРВОМУ FVG" : changeRule == 2 ? "№2: закрытие за границей потока" : "№3: попутное плечо с FVG + выход тенью за границу"
        flowDiagnostic := explanation + "\n" + (flowDir == 0 ? "ИНИЦИАЛИЗАЦИЯ" : flowDir == 1 ? "ЛОНГ" : "ШОРТ") + " → " + (newDir == 1 ? "ЛОНГ" : "ШОРТ") + " | свеча " + stamp + " МСК"
        if changeRule == 2 and na(selectedZone)
            flowDiagnostic += "\nВстречного FVG нет: поток по структурной ломаной"
        flowDiagnostic += "\nПрежний диапазон: " + str.tostring(archivedLo, format.mintick) + " — " + str.tostring(archivedHi, format.mintick)
        if changeRule == 1
            flowDiagnostic += "\nПервый FVG: " + str.tostring(guardBottom, format.mintick) + " — " + str.tostring(guardTop, format.mintick)
            flowDiagnostic += requireLiquidity ? "\nПодтверждение: " + reversalEvent + "\nСвеча события: " + str.format_time(reversalEventTime, "yyyy-MM-dd HH:mm", "Europe/Moscow") : "\nM: старшее подтверждение не требуется"
        if changeRule == 2
            flowDiagnostic += "\nClose: " + str.tostring(close, format.mintick) + " | граница: " + str.tostring(flowDir == 1 ? flowLo : flowHi, format.mintick)
        if changeRule == 3
            flowDiagnostic += "\nПробитая граница: " + str.tostring(extensionBoundary, format.mintick) + " | тень: " + str.tostring(extensionPrice, format.mintick)
            flowDiagnostic += "\nСвеча выхода: " + str.format_time(extensionTime, "yyyy-MM-dd HH:mm", "Europe/Moscow") + " МСК"
            flowDiagnostic += "\nСтаршее подтверждение не проверяется (условие №3)"
        if flowDir != 0
            prevStart := archivedStart
            prevEnd := beforeBarEnd
            prevLo := archivedLo
            prevHi := archivedHi
        flowDiagnostic += "\nНачало нового потока: " + str.format_time(newStart, "yyyy-MM-dd HH:mm", "Europe/Moscow") + " | цена: " + str.tostring(newDir == 1 ? newLo : newHi, format.mintick)
        // Координаты экстремумов независимы от свечи подтверждения смены.
        flowOriginLocked := newDir != flowDir or na(selectedZone)
        // Младший поток не расходует подтверждения старших потоков.
        // Продолжение и структурный разворот сохраняют старшее подтверждение.
        flowHasFvg := not na(selectedZone)
        structuralReverseLo := low
        structuralReverseHi := high
        structuralReverseLoTime := time
        structuralReverseHiTime := time
        flowDir := newDir
        flowStart := newStart
        flowSeedImpulse := changeRule == 3 ? continuationImpulse : changeRule == 1 ? ruleOneImpulse : changeRule == 2 ? reversalImpulse : not na(initialZone) ? initialZone.impulseTime : time[1]
        flowLo := newLo
        flowHi := newHi
        flowLoTime := newLoTime
        flowHiTime := newHiTime
        firstBroken := false
        firstBrokenAt := na
        continuationStart := na
        continuationImpulse := na
        continuationLo := na
        continuationHi := na
        continuationLoTime := na
        continuationHiTime := na
        reversalStart := na
        reversalImpulse := na
        reversalLo := na
        reversalHi := na
        reversalLoTime := na
        reversalHiTime := na
        extensionTime := na
        extensionBoundary := na
        extensionPrice := na
        extensionLegStart := na
        flowExtensionText := ""
        guardBalanced := false
        guardTop := na
        guardLeftTime := na
        guardBottom := na
        guardImpulse := na
        ruleOneStart := na
        ruleOneFvgAt := na
        ruleOneLoTime := na
        ruleOneHiTime := na
        continuationZone := na
        reversalZone := na
        ruleOneZone := na
        array.clear(ruleOneCandidates)
        if not na(selectedZone)
            guardTop := selectedZone.top
            guardLeftTime := selectedZone.leftTime
            guardBottom := selectedZone.bottom
            guardImpulse := selectedZone.impulseTime
            guardBalanced := selectedZone.balanced
            firstBroken := not na(selectedZone.brokenAt)
            firstBrokenAt := selectedZone.brokenAt
    MtfSnapshot current = na
    if exportNow
        current := f_mtfCopy(zones, flowDir, flowLo, flowHi, flowStart, time_close, time, prevStart, prevEnd, prevLo, prevHi, firstBroken, guardTop, guardBottom, guardLeftTime, guardImpulse, flowDiagnostic + f_ruleOneState(flowDir, firstBroken, ruleOneStart, requireLiquidity, lastLongEventTime, lastShortEventTime, firstBrokenAt, ruleOneFvgAt) + "\n" + liquidityAuditLong + "\n" + liquidityAuditShort + higherAudit + (flowExtensionText == "" ? "" : "\n" + flowExtensionText) + fvgBindingAudit)
    [structureHigh, structureLow, structureHighKey, structureLowKey, structureDirection] = f_legIdm(rawDir, rawStart, rawBase, rawOutsideDir, rawOutsideStart, rawOutsideBase)
    FlowLiquidity level = na
    if exportLevel
        level := FlowLiquidity.new(structureHigh, structureLow, structureHighKey, structureLowKey, guardTop, guardBottom, flowDir, flowDir != 0 and not firstBroken and not na(guardTop) and guardTop >= flowLo and guardBottom <= flowHi, guardBalanced, close, time_close, float(na), int(na), structureDirection)
    [previous, current, level]

f_monthLiquidity() =>
    [_, _, level] = f_flowSnapshot(false, "", "", "", int(na), int(na), true)
    f_exportLiquidity(level)

// Общие точки запросов: повторные вызовы используют одинаковые аргументы.
f_requestMonthLiquidity() =>
    request.security(syminfo.tickerid, "M", f_monthLiquidity(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = liquidityHistoryBars)

f_weekLiquidity() =>
    FlowLiquidity month = f_requestMonthLiquidity()
    [monthLong, monthShort, monthAudit, monthLongTime, monthShortTime] = f_flowLiquidityEvents(month, "M")
    [_, _, level] = f_flowSnapshot(true, monthLong, monthShort, monthAudit, monthLongTime, monthShortTime, true)
    f_exportLiquidity(level)

f_requestWeekLiquidity() =>
    request.security(syminfo.tickerid, "W", f_weekLiquidity(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = liquidityHistoryBars)

f_dayLiquidity() =>
    FlowLiquidity month = f_requestMonthLiquidity()
    FlowLiquidity week = f_requestWeekLiquidity()
    [monthLong, monthShort, monthAudit, monthLongTime, monthShortTime] = f_flowLiquidityEvents(month, "M")
    [weekLong, weekShort, weekAudit, weekLongTime, weekShortTime] = f_flowLiquidityEvents(week, "W")
    // Выбираем самое свежее событие; при равном времени неделя ближе месяца.
    string chosenLong = monthLong
    string chosenShort = monthShort
    int chosenLongTime = monthLongTime
    int chosenShortTime = monthShortTime
    if f_newerCapture(weekLongTime, weekShortTime, chosenLongTime, chosenShortTime)
        chosenLong := weekLong
        chosenShort := weekShort
        chosenLongTime := weekLongTime
        chosenShortTime := weekShortTime
    [_, _, level] = f_flowSnapshot(true, chosenLong, chosenShort, monthAudit + weekAudit, chosenLongTime, chosenShortTime, true)
    f_exportLiquidity(level)

f_requestDayLiquidity() =>
    request.security(syminfo.tickerid, "D", f_dayLiquidity(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = liquidityHistoryBars)

// H4 получает те же старшие события M/W/D, что раньше получал H1.
// При равном времени приоритет у ближайшего ТФ: D, затем W, затем M.
f_h4Liquidity() =>
    FlowLiquidity month = f_requestMonthLiquidity()
    FlowLiquidity week = f_requestWeekLiquidity()
    FlowLiquidity day = f_requestDayLiquidity()
    [monthLong, monthShort, monthAudit, monthLongTime, monthShortTime] = f_flowLiquidityEvents(month, "M")
    [weekLong, weekShort, weekAudit, weekLongTime, weekShortTime] = f_flowLiquidityEvents(week, "W")
    [dayLong, dayShort, dayAudit, dayLongTime, dayShortTime] = f_flowLiquidityEvents(day, "D")
    string chosenLong = monthLong
    string chosenShort = monthShort
    int chosenLongTime = monthLongTime
    int chosenShortTime = monthShortTime
    if f_newerCapture(weekLongTime, weekShortTime, chosenLongTime, chosenShortTime)
        chosenLong := weekLong
        chosenShort := weekShort
        chosenLongTime := weekLongTime
        chosenShortTime := weekShortTime
    if f_newerCapture(dayLongTime, dayShortTime, chosenLongTime, chosenShortTime)
        chosenLong := dayLong
        chosenShort := dayShort
        chosenLongTime := dayLongTime
        chosenShortTime := dayShortTime
    [_, _, level] = f_flowSnapshot(true, chosenLong, chosenShort, monthAudit + weekAudit + dayAudit, chosenLongTime, chosenShortTime, true)
    f_exportLiquidity(level)

f_requestH4Liquidity() =>
    request.security(syminfo.tickerid, "240", f_h4Liquidity(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true, calc_bars_count = liquidityHistoryBars)

// Собственные FVG младшего/прочего ТФ без направления, диапазона и условий потока.
// Детектор, отмена зон и момент публикации совпадают с общим расчётом FVG.
// На M1/M5 сохраняется тот же запрет внутренних свечей, что и в потоке H1.
f_fvgSnapshot() =>
    var array<MtfFvg> zones = array.new<MtfFvg>()
    var array<int> activeZoneIndices = array.new_int()
    bool exportNow = barstate.islast or barstate.islastconfirmedhistory
    MtfSnapshot previous = na
    if exportNow
        previous := f_mtfCopy(zones, 0, float(na), float(na), int(na), time_close[1], time[1], int(na), int(na), float(na), float(na), false, float(na), float(na), int(na), int(na), "")
    var float motherHi = na
    var float motherLo = na
    bool inside = not na(motherHi) and high <= motherHi and low >= motherLo
    if not inside
        motherHi := high
        motherLo := low
    // Отображаемым зонам достаточно статуса пробоя и времени окончания.
    f_fvgUpdateActive(zones, activeZoneIndices)
    // H1, M5 и M1: FVG создаём только из трёх невнутренних свечей.
    // На H4/D/W/M FVG разрешены и по внутренним свечам.
    bool allowInside = timeframe.in_seconds() > timeframe.in_seconds("60")
    bool allowed = allowInside or (not inside and not inside[1] and not inside[2])
    bool adjacentGap = low > high[1] or high < low[1] or low[1] > high[2] or high[1] < low[2]
    bool gapAllowed = not fvgExcludeGaps or not adjacentGap
    bool bull = not na(high[2]) and low > high[2] and gapAllowed
    bool bear = not na(low[2]) and high < low[2] and gapAllowed
    if allowed and (bull or bear)
        int side = bull ? 1 : -1
        float top = bull ? low : low[2]
        float bottom = bull ? high[2] : high
        f_fvgAppendActive(zones, activeZoneIndices, MtfFvg.new(time[2], time[1], top, bottom, side, true, time_close))
    MtfSnapshot current = na
    if exportNow
        current := f_mtfCopy(zones, 0, float(na), float(na), int(na), time_close, time, int(na), int(na), float(na), float(na), false, float(na), float(na), int(na), int(na), "")
    [previous, current]

// Таблица на H4/D/W/M не рисует зоны H1 и не использует его диагностику.
// Через младший request передаём только поля состояния; массив зон остаётся
// в исходном контексте. Расчёт f_mtfBundle проходит всю прежнюю историю.
f_summarySnapshot(MtfSnapshot snapshot) =>
    MtfSnapshot result = na
    if not na(snapshot)
        result := MtfSnapshot.new(na, snapshot.direction, snapshot.lo, snapshot.hi, snapshot.startTime, snapshot.closedAt, snapshot.sourceOpen, snapshot.prevStart, snapshot.prevEnd, snapshot.prevLo, snapshot.prevHi, snapshot.firstBroken, snapshot.firstTop, snapshot.firstBottom, "", snapshot.workingLeftTime, snapshot.workingImpulseTime)
    result

f_mtfBundle() =>
    float seconds = timeframe.in_seconds()
    bool calculateFlow = f_isFlowTimeframe()
    bool needsHigher = calculateFlow and not timeframe.ismonthly
    string longEvent = ""
    string shortEvent = ""
    string higherAudit = ""
    int longCaptureTime = na
    int shortCaptureTime = na
    FlowLiquidity month = na
    FlowLiquidity week = na
    FlowLiquidity h4 = na
    FlowLiquidity day = na
    if needsHigher
        month := f_requestMonthLiquidity()
        [monthLong, monthShort, monthAudit, monthLongTime, monthShortTime] = f_flowLiquidityEvents(month, "M")
        longEvent := monthLong
        shortEvent := monthShort
        higherAudit := monthAudit
        longCaptureTime := monthLongTime
        shortCaptureTime := monthShortTime
        if seconds < timeframe.in_seconds("W")
            week := f_requestWeekLiquidity()
            [weekLong, weekShort, weekAudit, weekLongTime, weekShortTime] = f_flowLiquidityEvents(week, "W")
            higherAudit += weekAudit
            // Более свежее событие недели заменяет выбранное; равное время — тоже.
            if f_newerCapture(weekLongTime, weekShortTime, longCaptureTime, shortCaptureTime)
                longEvent := weekLong
                shortEvent := weekShort
                longCaptureTime := weekLongTime
                shortCaptureTime := weekShortTime
        if seconds < timeframe.in_seconds("D")
            day := f_requestDayLiquidity()
            [dayLong, dayShort, dayAudit, dayLongTime, dayShortTime] = f_flowLiquidityEvents(day, "D")
            higherAudit += dayAudit
            // День заменяет выбранное событие только при более свежем или равном времени.
            if f_newerCapture(dayLongTime, dayShortTime, longCaptureTime, shortCaptureTime)
                longEvent := dayLong
                shortEvent := dayShort
                longCaptureTime := dayLongTime
                shortCaptureTime := dayShortTime
        if seconds < timeframe.in_seconds("240")
            h4 := f_requestH4Liquidity()
            [h4Long, h4Short, h4Audit, h4LongTime, h4ShortTime] = f_flowLiquidityEvents(h4, "H4")
            higherAudit += h4Audit
            // H4 — ближайший старший H1; при равном времени его событие приоритетнее.
            if f_newerCapture(h4LongTime, h4ShortTime, longCaptureTime, shortCaptureTime)
                longEvent := h4Long
                shortEvent := h4Short
                longCaptureTime := h4LongTime
                shortCaptureTime := h4ShortTime
    MtfSnapshot previous = na
    MtfSnapshot current = na
    if calculateFlow
        [flowPrevious, flowCurrent, _] = f_flowSnapshot(needsHigher, longEvent, shortEvent, higherAudit, longCaptureTime, shortCaptureTime, false)
        previous := flowPrevious
        current := flowCurrent
    else
        [fvgPrevious, fvgCurrent] = f_fvgSnapshot()
        previous := fvgPrevious
        current := fvgCurrent
    // Только запрос H1 из старшего графика обслуживает одну таблицу.
    // main_period остаётся ТФ графика и внутри вложенного request.
    bool summaryOnly = seconds == 3600 and timeframe.in_seconds(timeframe.main_period) > 3600
    if summaryOnly
        previous := f_summarySnapshot(previous)
        current := f_summarySnapshot(current)
        if not (barstate.islast or barstate.islastconfirmedhistory)
            h4 := na
            day := na
            week := na
            month := na
    [previous, current, h4, day, week, month]

f_mtfSnapshot() =>
    [previous, current, _, _, _, _] = f_mtfBundle()
    [previous, current]

f_mtfConfirmed(MtfSnapshot previous, MtfSnapshot current, int cutoff) =>
    MtfSnapshot result = na
    if not na(current)
        if not na(current.closedAt) and current.closedAt <= cutoff
            result := current
    if na(result) and not na(previous)
        if not na(previous.closedAt) and previous.closedAt <= cutoff
            result := previous
    result

// На realtime и при загрузке правого края внутри фактически открытого
// исходного интервала используем текущий поток. Прошлые интервалы не допускаются:
// lookahead_on не должен подмешивать завершённый позже HTF-снимок на истории.
// Зоны всегда остаются подтверждёнными; меняются только параметры потока.
f_liveFlow(MtfSnapshot confirmed, MtfSnapshot developing) =>
    MtfSnapshot result = confirmed
    if not na(confirmed) and not na(developing)
        bool liveInitial = barstate.islast and not na(developing.sourceOpen) and not na(developing.closedAt) and developing.sourceOpen <= time and time <= timenow and developing.sourceOpen <= timenow and timenow < developing.closedAt
        if (barstate.isrealtime or liveInitial) and developing.direction == confirmed.direction and developing.startTime == confirmed.startTime
            result := MtfSnapshot.new(confirmed.zones, confirmed.direction, confirmed.direction == -1 ? math.min(confirmed.lo, developing.lo) : confirmed.lo, confirmed.direction == 1 ? math.max(confirmed.hi, developing.hi) : confirmed.hi, confirmed.startTime, confirmed.closedAt, confirmed.sourceOpen, confirmed.prevStart, confirmed.prevEnd, confirmed.prevLo, confirmed.prevHi, confirmed.firstBroken, confirmed.firstTop, confirmed.firstBottom, confirmed.diagnostic, confirmed.workingLeftTime, confirmed.workingImpulseTime)
    result

f_mtfInFlow(MtfFvg zone, MtfSnapshot snapshot, bool includePrevious = false) =>
    bool matches = false
    if not na(snapshot)
        bool currentFlow = snapshot.direction != 0 and zone.impulseTime >= snapshot.startTime and zone.top >= snapshot.lo and zone.bottom <= snapshot.hi
        bool previousFlow = includePrevious and not na(snapshot.prevStart) and zone.impulseTime >= snapshot.prevStart and zone.impulseTime < snapshot.prevEnd and zone.top >= snapshot.prevLo and zone.bottom <= snapshot.prevHi
        matches := currentFlow or previousFlow
    matches


// Для переноса берём только выбранный рабочий FVG, независимо от истории зон.
f_mtfWorkingZone(MtfSnapshot snapshot) =>
    MtfFvg result = na
    if not na(snapshot)
        bool working = snapshot.direction != 0 and not snapshot.firstBroken and not na(snapshot.firstTop) and not na(snapshot.firstBottom)
        bool inFlow = snapshot.firstTop >= snapshot.lo and snapshot.firstBottom <= snapshot.hi
        if working and inFlow and not na(snapshot.workingLeftTime) and not na(snapshot.workingImpulseTime)
            result := MtfFvg.new(snapshot.workingLeftTime, snapshot.workingImpulseTime, snapshot.firstTop, snapshot.firstBottom, snapshot.direction, true, snapshot.closedAt)
    result

f_mtfInH1(MtfFvg child, array<MtfFvg> parents) =>
    bool matches = false
    for parent in parents
        bool overlaps = child.bottom < parent.top and child.top > parent.bottom
        // Старые зоны на тех же ценах не принадлежат более позднему рабочему FVG.
        bool afterParentStart = not na(child.leftTime) and not na(parent.leftTime) and child.leftTime >= parent.leftTime
        if parent.active and overlaps and afterParentStart
            matches := true
            break
    matches

f_mtfName() =>
    float seconds = timeframe.in_seconds()
    timeframe.isdaily and timeframe.multiplier == 1 ? "D" : timeframe.isweekly and timeframe.multiplier == 1 ? "W" : timeframe.ismonthly and timeframe.multiplier == 1 ? "M" : timeframe.isminutes ? (seconds >= 3600 and seconds % 3600 == 0 ? "H" + str.tostring(int(seconds / 3600)) : "M" + timeframe.period) : timeframe.period

f_mtfDraw(MtfFvg zone, string tfName, array<box> drawings, int rightTime) =>
    color zoneColor = not zone.active ? fvgFilledColor : zone.side == 1 ? fvgBullColor : fvgBearColor
    int endTime = zone.active ? rightTime : zone.rightTime
    string title = "FVG " + tfName
    string fontSize = switch tfName
        "M" => fvgFontM
        "W" => fvgFontW
        "D" => fvgFontD
        "H1" => fvgFontH1
        "H4" => fvgFontH4
        "M1" => fvgFontM1
        => fvgFontM5
    box area = box.new(left = zone.leftTime, top = zone.top, right = endTime, bottom = zone.bottom, xloc = xloc.bar_time, border_color = color.new(zoneColor, 30), border_width = fvgBorderWidth, bgcolor = zoneColor, text = title, text_color = color.new(zoneColor, 0), text_size = fontSize, text_halign = text.align_right, text_valign = text.align_center)
    float mid = (zone.top + zone.bottom) / 2.0
    box middle = box.new(left = zone.leftTime, top = mid, right = endTime, bottom = mid, xloc = xloc.bar_time, border_color = color.new(zoneColor, 0), border_width = fvgMiddleWidth, border_style = line.style_dotted, bgcolor = na)
    array.push(drawings, area)
    array.push(drawings, middle)

// Потоки: только H1/H4/D/W/M. На M1/M5 — собственные FVG и перенос старших данных.
float mtfChartSeconds = timeframe.in_seconds()
bool mtfM1 = mtfChartSeconds == 60
bool mtfM5 = mtfChartSeconds == 300
bool mtfLower = mtfM1 or mtfM5
bool mtfH1 = mtfChartSeconds == 3600
bool mtfH4 = mtfChartSeconds == 14400
bool mtfD = timeframe.isdaily and timeframe.multiplier == 1
bool mtfW = timeframe.isweekly and timeframe.multiplier == 1
bool showH1OnM5 = input.bool(true, "FVG H1 на M1 / M5", group = FVG_GROUP)
bool showH4OnM5 = input.bool(true, "FVG H4 на M1 / M5 / H1", group = FVG_GROUP)
bool showDOnM5 = input.bool(true, "FVG D на M1 / M5 / H1 / H4", group = FVG_GROUP)
bool showWOnM5 = input.bool(true, "FVG W на M1 / M5 / H1 / H4 / D", group = FVG_GROUP)
bool showMOnM5 = input.bool(true, "FVG M на M1 / M5 / H1 / H4 / D / W", group = FVG_GROUP)
bool currentFvgTableEnabled = input.bool(true, "Состояние текущего инструмента H1 / H4 / D / W / M", group = "Сводка инструмента", tooltip = "Цвет ячейки ТФ: зелёный — цена в рабочем лонговом FVG, красный — в шортовом, серый — вне рабочего FVG или нет данных.")
float currentFvgCellWidth = input.float(3.0, "Текущий инструмент: ширина ячейки (%)", minval = 1, maxval = 10, step = 0.5, group = "Сводка инструмента")
float currentFvgCellHeight = input.float(0.0, "Текущий инструмент: высота ячейки (%)", minval = 0, maxval = 20, step = 0.5, group = "Сводка инструмента", tooltip = "0 — автоматическая высота по размеру текста.")
string currentFvgFontSize = input.string(size.normal, "Текущий инструмент: размер текста", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = "Сводка инструмента")
string currentFlowArrowSize = input.string(size.large, "Текущий инструмент: размер стрелок потока", options = [size.normal, size.large, size.huge], group = "Сводка инструмента")
[localPrevious, localCurrent, localH4Level, localDayLevel, localWeekLevel, localMonthLevel] = f_mtfBundle()
// Пять плоских box вместо line: отдельный бюджет, прежние 500 line не затронуты.
f_drawPreviousFlow(MtfSnapshot snapshot, array<box> drawings) =>
    if flowShowPrevious and not na(snapshot)
        if not na(snapshot.prevStart) and not na(snapshot.prevEnd) and not na(snapshot.prevLo) and not na(snapshot.prevHi)
            array<float> ratios = array.from(0.0, 0.4, 0.5, 0.6, 1.0)
            for ratio in ratios
                float price = snapshot.prevLo + (snapshot.prevHi - snapshot.prevLo) * ratio
                string title = ""
                box level = box.new(left = snapshot.prevStart, top = price, right = snapshot.prevEnd, bottom = price, xloc = xloc.bar_time, border_color = flowPreviousColor, border_width = flowLineWidth, border_style = line.style_dashed, bgcolor = na, text = title, text_color = flowPreviousColor, text_size = flowFontSize, text_halign = text.align_right, text_valign = text.align_bottom)
                array.push(drawings, level)

var array<box> flowLevelBoxes = array.new<box>()
if barstate.islast
    while array.size(flowLevelBoxes) > 0
        box.delete(array.pop(flowLevelBoxes))
    // В Replay календарное timenow позже проигрываемой свечи и ошибочно
    // подтверждает её предварительный разворот. Используем время самого графика.
    int chartFlowCutoff = barstate.isconfirmed and not na(time_close) ? time_close : time
    MtfSnapshot chartFlow = f_liveFlow(f_mtfConfirmed(localPrevious, localCurrent, chartFlowCutoff), localCurrent)
    if flowOnChart and flowShowLevels and not na(chartFlow)
        f_drawPreviousFlow(chartFlow, flowLevelBoxes)
    if flowOnChart and flowShowLevels and not na(chartFlow) and chartFlow.direction != 0
        array<float> ratios = array.from(0.0, 0.4, 0.5, 0.6, 1.0)
        int flowRightTime = na(time_close) ? time : time_close
        for levelIndex = 0 to 4
            float ratio = array.get(ratios, levelIndex)
            float levelPrice = chartFlow.lo + (chartFlow.hi - chartFlow.lo) * ratio
            color levelColor = ratio == 0.0 ? flowColor0 : ratio == 0.4 ? flowColor04 : ratio == 0.5 ? flowColor05 : ratio == 0.6 ? flowColor06 : flowColor1
            string levelText = flowShowData ? str.tostring(ratio) + " (" + str.tostring(levelPrice, format.mintick) + ")" : ""
            box levelBox = box.new(left = chartFlow.startTime, top = levelPrice, right = flowRightTime, bottom = levelPrice, xloc = xloc.bar_time, border_color = levelColor, border_width = flowLineWidth, bgcolor = na, text = levelText, text_color = levelColor, text_size = flowFontSize, text_halign = text.align_right, text_valign = text.align_bottom)
            array.push(flowLevelBoxes, levelBox)


MtfSnapshot h1Previous = na
MtfSnapshot h1Current = na
FlowLiquidity summaryH4 = localH4Level
FlowLiquidity summaryDay = localDayLevel
FlowLiquidity summaryWeek = localWeekLevel
FlowLiquidity summaryMonth = localMonthLevel
MtfSnapshot h4Previous = na
MtfSnapshot h4Current = na
MtfSnapshot dPrevious = na
MtfSnapshot dCurrent = na
MtfSnapshot wPrevious = na
MtfSnapshot wCurrent = na
MtfSnapshot monthPrevious = na
MtfSnapshot monthCurrent = na
if fvgEnabled and (mtfLower or mtfH1) and showH4OnM5
    [prev, curr] = request.security(syminfo.tickerid, "240", f_mtfSnapshot(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    h4Previous := prev
    h4Current := curr
if fvgEnabled and (mtfLower or mtfH1 or mtfH4) and showDOnM5
    [prev, curr] = request.security(syminfo.tickerid, "D", f_mtfSnapshot(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    dPrevious := prev
    dCurrent := curr
if fvgEnabled and (mtfLower or mtfH1 or mtfH4 or mtfD) and showWOnM5
    [prev, curr] = request.security(syminfo.tickerid, "W", f_mtfSnapshot(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    wPrevious := prev
    wCurrent := curr
if fvgEnabled and (mtfLower or mtfH1 or mtfH4 or mtfD or mtfW) and showMOnM5
    [prev, curr] = request.security(syminfo.tickerid, "M", f_mtfSnapshot(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    monthPrevious := prev
    monthCurrent := curr
bool needsH1Snapshot = (mtfLower and (fvgEnabled or (flowShowLevels and flowH1OnM5))) or (currentFvgTableEnabled and not mtfH1)
if needsH1Snapshot
    // На H4/D/W/M H1 является младшим ТФ: нужен последний доступный H1 внутри бара.
    // На M1/M5 сохраняем перенос подтверждённых старших зон.
    [requestedPrevious, requestedCurrent, requestedH4, requestedDay, requestedWeek, requestedMonth] = request.security(syminfo.tickerid, "60", f_mtfBundle(), gaps = barmerge.gaps_off, lookahead = mtfChartSeconds > 3600 ? barmerge.lookahead_off : barmerge.lookahead_on)
    h1Previous := requestedPrevious
    h1Current := requestedCurrent
    summaryH4 := requestedH4
    summaryDay := requestedDay
    summaryWeek := requestedWeek
    summaryMonth := requestedMonth

// Состояние текущего инструмента: используем тот же H1-пакет, что и перенос FVG.
f_summaryHigherSide(LiquidityView level, float price) =>
    int side = 0
    if not na(level)
        if level.working and level.side != 0 and price >= level.bottom and price <= level.top
            side := level.side
    side

// Рабочая зона хранится в снимке независимо от массива отображаемых FVG.
f_summaryFlowSide(MtfSnapshot snapshot, float price) =>
    int side = 0
    if not na(snapshot)
        bool working = snapshot.direction != 0 and not snapshot.firstBroken and not na(snapshot.firstTop) and not na(snapshot.firstBottom)
        bool inFlow = snapshot.firstTop >= snapshot.lo and snapshot.firstBottom <= snapshot.hi
        if working and inFlow and price >= snapshot.firstBottom and price <= snapshot.firstTop
            side := snapshot.direction
    side

// Повторно используем H1-снимок FVG: дополнительный request.security не нужен.
// flowLevelBoxes уже очищены выше на последнем баре.
if barstate.islast and mtfLower and flowShowLevels and flowH1OnM5
    int flowCutoff = barstate.isconfirmed and not na(time_close) ? time_close : time
    MtfSnapshot h1Flow = f_liveFlow(f_mtfConfirmed(h1Previous, h1Current, flowCutoff), h1Current)
    if not na(h1Flow)
        f_drawPreviousFlow(h1Flow, flowLevelBoxes)
        if h1Flow.direction != 0 and not na(h1Flow.lo) and not na(h1Flow.hi) and not na(h1Flow.startTime)
            array<float> ratios = array.from(0.0, 0.4, 0.5, 0.6, 1.0)
            int flowRightTime = na(time_close) ? time : time_close
            for levelIndex = 0 to 4
                float ratio = array.get(ratios, levelIndex)
                float levelPrice = h1Flow.lo + (h1Flow.hi - h1Flow.lo) * ratio
                color levelColor = ratio == 0.0 ? flowColor0 : ratio == 0.4 ? flowColor04 : ratio == 0.5 ? flowColor05 : ratio == 0.6 ? flowColor06 : flowColor1
                string levelText = flowShowData ? "H1 " + str.tostring(ratio) + " (" + str.tostring(levelPrice, format.mintick) + ")" : ""
                box levelBox = box.new(left = h1Flow.startTime, top = levelPrice, right = flowRightTime, bottom = levelPrice, xloc = xloc.bar_time, border_color = levelColor, border_width = flowLineWidth, bgcolor = na, text = levelText, text_color = levelColor, text_size = flowFontSize, text_halign = text.align_right, text_valign = text.align_bottom)
                array.push(flowLevelBoxes, levelBox)

var array<box> mtfDrawings = array.new<box>()
var table mtfStatus = table.new(position.bottom_center, 1, 1)
if barstate.islast
    table.cell(mtfStatus, 0, 0, "", bgcolor = color.new(color.black, 100))
    while array.size(mtfDrawings) > 0
        box.delete(array.pop(mtfDrawings))
    if fvgEnabled
        int cutoff = barstate.isconfirmed and not na(time_close) ? time_close : time
        int rightTime = na(time_close) ? time : time_close
        MtfSnapshot localData = f_liveFlow(f_mtfConfirmed(localPrevious, localCurrent, cutoff), localCurrent)
        MtfSnapshot h1Data = f_liveFlow(f_mtfConfirmed(h1Previous, h1Current, cutoff), h1Current)
        array<MtfFvg> h1Parents = array.new<MtfFvg>()
        int drawn = 0
        if mtfLower and showH1OnM5 and not na(h1Data)
            // Родители M1/M5 — только те рабочие старшие FVG, которые рисуем.
            MtfFvg workingH1 = f_mtfWorkingZone(h1Data)
            if not na(workingH1) and drawn < fvgMaxZones
                f_mtfDraw(workingH1, "H1", mtfDrawings, rightTime)
                array.push(h1Parents, workingH1)
                drawn += 1
        if mtfLower or mtfH1 or mtfH4 or mtfD or mtfW
            array<MtfSnapshot> higherData = array.from(f_liveFlow(f_mtfConfirmed(h4Previous, h4Current, cutoff), h4Current), f_liveFlow(f_mtfConfirmed(dPrevious, dCurrent, cutoff), dCurrent), f_liveFlow(f_mtfConfirmed(wPrevious, wCurrent, cutoff), wCurrent), f_liveFlow(f_mtfConfirmed(monthPrevious, monthCurrent, cutoff), monthCurrent))
            array<string> higherNames = array.from("H4", "D", "W", "M")
            for tfIndex = 0 to 3
                MtfSnapshot snapshot = array.get(higherData, tfIndex)
                if not na(snapshot)
                    MtfFvg workingZone = f_mtfWorkingZone(snapshot)
                    if not na(workingZone) and drawn < fvgMaxZones
                        f_mtfDraw(workingZone, array.get(higherNames, tfIndex), mtfDrawings, rightTime)
                        if mtfLower
                            array.push(h1Parents, workingZone)
                        drawn += 1
        if not na(localData)
            int index = array.size(localData.zones) - 1
            while index >= 0 and drawn < fvgMaxZones
                MtfFvg zone = array.get(localData.zones, index)
                bool allowed = mtfLower ? f_mtfInH1(zone, h1Parents) : (not flowOnChart or not fvgOnlyInFlow or f_mtfInFlow(zone, localData, true))
                // Как на старших ТФ: пробитая зона рисуется до своей свечи пробоя.
                if allowed and (not mtfLower or (mtfM1 ? fvgShowM1 : fvgShowM5))
                    f_mtfDraw(zone, f_mtfName(), mtfDrawings, rightTime)
                    drawn += 1
                index -= 1
        if mtfLower and (fvgMtfDiagnostics or na(h1Data))
            string diagnostic = "FVG H1: нет подтверждённого снимка"
            if not na(h1Data)
                diagnostic := "H1: зон " + str.tostring(array.size(h1Data.zones)) + " | старших зон после фильтра " + str.tostring(array.size(h1Parents)) + " | закрытие " + str.format_time(h1Data.closedAt, "dd.MM HH:mm", syminfo.timezone)
            diagnostic += " | показано " + str.tostring(drawn)
            table.cell(mtfStatus, 0, 0, diagnostic, bgcolor = color.new(color.orange, 20), text_color = color.white, text_size = size.small)


// Сводка текущего инструмента: пять ТФ, строка FVG и строка потока.
var table board = table.new(position.top_right, 5, 2, border_width = 1)
if barstate.islast
    table.clear(board, 0, 0, 4, 1)
    if currentFvgTableEnabled
        // Сводка на старшем графике относится к правому краю, не к началу месяца.
        // timenow ограничивает текущую незакрытую свечу, time_close — историю/Replay.
        int summaryCutoff = mtfChartSeconds > 3600 and not na(time_close) ? math.min(timenow, time_close) : barstate.isconfirmed and not na(time_close) ? time_close : time
        MtfSnapshot summaryH1 = mtfH1 ? f_liveFlow(f_mtfConfirmed(localPrevious, localCurrent, summaryCutoff), localCurrent) : f_liveFlow(f_mtfConfirmed(h1Previous, h1Current, summaryCutoff), h1Current)
        // Все столбцы относятся к одному правому краю H1-пакета. На начальном
        // расчёте открытой W/M-свечи её time ещё не допускает свежие D/W-снимки.
        LiquidityView confirmedH4 = f_confirmedLiquidity(summaryH4, summaryCutoff)
        LiquidityView confirmedDay = f_confirmedLiquidity(summaryDay, summaryCutoff)
        LiquidityView confirmedWeek = f_confirmedLiquidity(summaryWeek, summaryCutoff)
        LiquidityView confirmedMonth = f_confirmedLiquidity(summaryMonth, summaryCutoff)
        array<int> sides = array.from(f_summaryFlowSide(summaryH1, close), f_summaryHigherSide(confirmedH4, close), f_summaryHigherSide(confirmedDay, close), f_summaryHigherSide(confirmedWeek, close), f_summaryHigherSide(confirmedMonth, close))
        // Направление потока независимо от нахождения цены в рабочем FVG.
        array<int> directions = array.from(na(summaryH1) ? 0 : summaryH1.direction, na(confirmedH4) ? 0 : confirmedH4.side, na(confirmedDay) ? 0 : confirmedDay.side, na(confirmedWeek) ? 0 : confirmedWeek.side, na(confirmedMonth) ? 0 : confirmedMonth.side)
        // Свой ТФ берём из того же подтверждённого расчёта, что и диагностику.
        // Вложенный H1-пакет может ещё не иметь старшего снимка на короткой истории.
        int localCutoff = barstate.isconfirmed and not na(time_close) ? time_close : time
        MtfSnapshot ownFlow = f_mtfConfirmed(localPrevious, localCurrent, localCutoff)
        int ownColumn = mtfH4 ? 1 : mtfD ? 2 : mtfW ? 3 : timeframe.ismonthly and timeframe.multiplier == 1 ? 4 : -1
        if ownColumn >= 0
            array.set(directions, ownColumn, na(ownFlow) ? 0 : ownFlow.direction)
            array.set(sides, ownColumn, f_summaryFlowSide(ownFlow, close))
        array<string> names = array.from("H1", "H4", "D", "W", "M")
        for column = 0 to 4
            int side = array.get(sides, column)
            color cellColor = side == 1 ? color.new(#388E3C, 0) : side == -1 ? color.new(#B22833, 0) : color.new(#636363, 0)
            string stateText = side == 1 ? "Цена в рабочем лонговом FVG" : side == -1 ? "Цена в рабочем шортовом FVG" : "Вне рабочего FVG / нет рабочего FVG или данных"
            table.cell(board, column, 0, array.get(names, column), bgcolor = cellColor, text_color = color.white, width = currentFvgCellWidth, height = currentFvgCellHeight, text_size = currentFvgFontSize, tooltip = syminfo.ticker + " · " + array.get(names, column) + ": " + stateText)
            int direction = array.get(directions, column)
            color arrowColor = direction == 1 ? color.new(#388E3C, 0) : direction == -1 ? color.new(#B22833, 0) : color.new(#636363, 0)
            string arrowText = direction == 1 ? "⬆" : direction == -1 ? "⬇" : "—"
            string flowText = direction == 1 ? "Лонговый поток" : direction == -1 ? "Шортовый поток" : column == 0 and na(summaryH1) ? "H1: нет подтверждённого снимка" : "Поток ещё не инициализирован"
            table.cell(board, column, 1, arrowText, bgcolor = arrowColor, text_color = color.white, width = currentFvgCellWidth, height = currentFvgCellHeight, text_size = currentFlowArrowSize, tooltip = syminfo.ticker + " · " + array.get(names, column) + ": " + flowText)


//------------------------------------------------------------------------------
// VWAP: данные текущего графика, без дополнительных request.*().
//------------------------------------------------------------------------------
string VWAP_GROUP = "VWAP"
bool vwapEnabled = input.bool(true, "Показывать VWAP", group = VWAP_GROUP)
string vwapAnchor = input.string("Session", "Период", options = ["Session", "Week", "Month", "Quarter", "Year", "Decade", "Century"], group = VWAP_GROUP)
float vwapSource = input.source(hlc3, "Источник", group = VWAP_GROUP)
color vwapColor = input.color(#0C3299, "Цвет VWAP", group = VWAP_GROUP)
int vwapWidth = input.int(3, "Толщина VWAP", minval = 1, maxval = 5, group = VWAP_GROUP)
bool vwapShowPrevious = input.bool(true, "Продлевать VWAP прошлого периода", group = VWAP_GROUP)
color vwapPreviousColor = input.color(#0C3299, "Цвет прошлого VWAP", group = VWAP_GROUP)
int vwapPreviousWidth = input.int(3, "Толщина прошлого VWAP", minval = 1, maxval = 5, group = VWAP_GROUP)
const int VWAP_PREVIOUS_LIMIT = 50


// Сброс сессии — начало дневного бара инструмента (не клиринг МОЕХ).
bool vwapCalendarReset = switch vwapAnchor
    "Session" => timeframe.change("D")
    "Week" => timeframe.change("W")
    "Month" => timeframe.change("M")
    "Quarter" => timeframe.change("3M")
    "Year" => timeframe.change("12M")
    "Decade" => timeframe.change("12M") and year % 10 == 0
    "Century" => timeframe.change("12M") and year % 100 == 0
    => false
bool vwapReset = barstate.isfirst or vwapCalendarReset or na(vwapSource[1])
// Вызов на каждой свече сохраняет последовательность расчёта ta.vwap.
float vwapRaw = ta.vwap(vwapSource, vwapReset)
// Из рабочих ТФ VWAP показывается только на M1/M5.
bool vwapVisible = vwapEnabled and mtfLower

// Нет положительного объёма: скрываем только VWAP, остальные блоки работают.
var float vwapPeriodVolume = 0.0
if vwapReset
    vwapPeriodVolume := 0.0
vwapPeriodVolume += math.max(nz(volume), 0.0)
bool vwapHasPeriodVolume = vwapPeriodVolume > 0
float vwapShown = vwapVisible and vwapHasPeriodVolume ? vwapRaw : na

var array<line> vwapPreviousLines = array.new_line()
var line vwapActivePreviousLine = na
var float vwapPreviousValue = na
if vwapCalendarReset and not barstate.isfirst
    if not na(vwapActivePreviousLine)
        line.set_x2(vwapActivePreviousLine, time)
    vwapActivePreviousLine := na
    // Берём финальное значение именно последнего периода, без подстановки старых.
    vwapPreviousValue := vwapPeriodVolume[1] > 0 ? vwapRaw[1] : na
    if vwapVisible and vwapShowPrevious and not na(vwapPreviousValue)
        if array.size(vwapPreviousLines) >= VWAP_PREVIOUS_LIMIT
            line.delete(array.shift(vwapPreviousLines))
        vwapActivePreviousLine := line.new(time, vwapPreviousValue, na(time_close) ? time : time_close, vwapPreviousValue, xloc = xloc.bar_time, color = vwapPreviousColor, width = vwapPreviousWidth, style = line.style_dashed)
        array.push(vwapPreviousLines, vwapActivePreviousLine)
else if not na(vwapActivePreviousLine)
    line.set_x2(vwapActivePreviousLine, na(time_close) ? time : time_close)

plot(vwapShown, title = "VWAP", color = vwapColor, linewidth = vwapWidth)
plot(vwapVisible and vwapShowPrevious ? vwapPreviousValue : na, title = "VWAP прошлого периода", color = vwapPreviousColor, display = display.price_scale, show_last = 1)

// Диагностика берётся из подтверждённого снимка: работает и в Replay.
var table flowDiagnosticTable = table.new(position.bottom_left, 1, 2)
if barstate.islast
    table.clear(flowDiagnosticTable, 0, 0, 0, 1)
    if flowDiagnosticEnabled
        int cutoff = barstate.isconfirmed and not na(time_close) ? time_close : time
        // На M1/M5 показываем диагностику действующего H1-потока.
        MtfSnapshot localDiagnostic = f_mtfConfirmed(localPrevious, localCurrent, cutoff)
        MtfSnapshot h1Diagnostic = f_liveFlow(f_mtfConfirmed(h1Previous, h1Current, cutoff), h1Current)
        bool useHigherDiagnostic = mtfLower
        MtfSnapshot diagnosticData = useHigherDiagnostic ? h1Diagnostic : flowOnChart ? localDiagnostic : na
        string diagnosticText = not mtfLower and not flowOnChart ? "Поток рассчитывается только на H1 / H4 / D / W / M" : na(diagnosticData) ? "Нет подтверждённого снимка потока" : diagnosticData.diagnostic
        if not na(diagnosticData) and not na(diagnosticData.closedAt)
            diagnosticText += "\nСнимок на закрытие: " + str.format_time(diagnosticData.closedAt, "yyyy-MM-dd HH:mm", "Europe/Moscow")
        MtfSnapshot pendingData = useHigherDiagnostic ? h1Current : localCurrent
        if not na(diagnosticData) and not na(pendingData) and not na(pendingData.closedAt) and pendingData.closedAt > cutoff and pendingData.direction != diagnosticData.direction
            diagnosticText += "\nНа формирующейся свече: " + (pendingData.direction == 1 ? "ЛОНГ" : "ШОРТ") + "; подтверждение после её закрытия"
        diagnosticText := "ПОСЛЕДНЯЯ СМЕНА / СТАРТ | " + (useHigherDiagnostic ? "H1" : timeframe.period) + "\n" + diagnosticText
        table.cell(flowDiagnosticTable, 0, 0, diagnosticText, text_color = color.white, bgcolor = color.new(color.black, 15), text_size = flowDiagnosticFont, text_halign = text.align_left)
        table.cell(flowDiagnosticTable, 0, 1, "", height = flowDiagnosticBottomOffset, bgcolor = color.new(color.black, 100))
