//@version=6
indicator(
     "Структура + FVG + VWAP v2.11 H1 + H4",
     shorttitle = "Структура + FVG + VWAP H1 + H4 v2.11",
     overlay = true,
     max_lines_count = 500,
     max_labels_count = 50,
     max_polylines_count = 63,
     max_boxes_count = 410)

//------------------------------------------------------------------------------
// Настройки
//------------------------------------------------------------------------------

// Бюджет линий (max_lines_count = 500): до 390 подтверждённых отрезков
// + 50 прошлых VWAP + 3 линии IDM + 2 формирующихся отрезка (текущее плечо
// и база внешней цепочки) = 445. В режиме «только диапазон» вместо IDM
// рисуются 2 линии MAX/MIN, итого 444.
// BOS/CHOCH/MAX/MIN-полилинии имеют отдельный лимит и сюда не входят.
const int STRUCTURE_HISTORY_LIMIT = 390

string GROUP_VIEW = "Структурное движение"
string GROUP_MARKET = "Структура рынка"

// Ломаная считается по high/low: пробой границы материнской свечи
// засчитывается телом или тенью, закрытие не требуется.
// direction — направление плеча, которое рисуется сейчас. На внешней свече он
// сразу переключается на следующее плечо, поэтому пока цепочка активна
// outsideOrigin == -direction.
// Внешняя вершина переносится на каждую следующую внешнюю свечу (high растёт,
// low падает), пока не случится односторонний выход. Предыдущая внешняя свеча
// поглощается: отдельного пивота она не создаёт.
// Ретроспективные BOS/CHOCH могут пересматриваться при изменении истории.
// Поток обновляется внутри свечи, BOS/CHOCH подтверждаются закрытием.
// Окраска внутренних свечей обновляется внутри текущей свечи.

bool showStructure = input.bool(true, "Структурная ломаная", group = GROUP_VIEW)
bool showDevelopingLeg = input.bool(true, "Последнее формирующееся плечо", group = GROUP_VIEW)
int maxSegments = input.int(100, "Хранить подтверждённых отрезков", minval = 10, maxval = STRUCTURE_HISTORY_LIMIT, tooltip = "До 390 отрезков структуры. Отдельный запас оставлен для уровней IDM и формирующихся отрезков.", group = GROUP_VIEW)
int structureWidth = input.int(3, "Толщина структурной линии", minval = 1, maxval = 5, group = GROUP_VIEW)

color upColor = input.color(#056656, "Восходящее плечо", group = GROUP_VIEW)
color downColor = input.color(#B22833, "Нисходящее плечо", group = GROUP_VIEW)

bool showMarketOnlyOnH1 = input.bool(true, "Показывать структуру рынка только на H1 / H4", group = GROUP_MARKET)
bool enableMarketStructureInput = input.bool(true, "BOS / CHOCH / MAX / MIN", group = GROUP_MARKET)
bool showMarketIdmInput = input.bool(true, "Показывать IDM уровней", group = GROUP_MARKET)
bool showMarketStatusInput = input.bool(false, "Показывать состояние инициализации", group = GROUP_MARKET)

bool marketChartIsH1 = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("60")
bool marketChartIsH4 = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds("240")
bool marketVisibleOnChart = not showMarketOnlyOnH1 or marketChartIsH1 or marketChartIsH4
// Индекс свечи совпадает с индексом истории: допустимы 0..99 999.
// Историю не сдвигаем: иначе изменились бы исходные MAX/MIN и весь replay.
const int MARKET_HISTORY_LIMIT = 100000
bool marketHistoryLimitReached = enableMarketStructureInput and marketVisibleOnChart and bar_index >= MARKET_HISTORY_LIMIT
bool enableMarketStructure = enableMarketStructureInput and marketVisibleOnChart and not marketHistoryLimitReached
bool showMarketIdm = showMarketIdmInput and marketVisibleOnChart
bool showMarketStatus = showMarketStatusInput and enableMarketStructure

color marketBosColor = input.color(#512DA8, "BOS", group = GROUP_MARKET)
color marketChochColor = input.color(#7B1FA2, "CHOCH", group = GROUP_MARKET)
color marketMaxColor = input.color(#056656, "MAX", group = GROUP_MARKET)
color marketMinColor = input.color(#B22833, "MIN", group = GROUP_MARKET)
color marketIdmColor = input.color(#0097A7, "IDM", group = GROUP_MARKET)

int marketBosWidth = input.int(3, "Толщина BOS", minval = 1, maxval = 5, group = GROUP_MARKET)
int marketChochWidth = input.int(3, "Толщина CHOCH", minval = 1, maxval = 5, group = GROUP_MARKET)
int marketMaxWidth = input.int(3, "Толщина MAX", minval = 1, maxval = 5, group = GROUP_MARKET)
int marketMinWidth = input.int(3, "Толщина MIN", minval = 1, maxval = 5, group = GROUP_MARKET)
int marketIdmWidth = input.int(2, "Толщина IDM", minval = 1, maxval = 5, group = GROUP_MARKET)

//------------------------------------------------------------------------------
// Служебные функции
//------------------------------------------------------------------------------

var array<line> confirmedSegments = array.new_line()

f_storeSegment(line segment) =>
    array.push(confirmedSegments, segment)
    if array.size(confirmedSegments) > maxSegments
        line.delete(array.shift(confirmedSegments))

f_confirmSegment(
     line developingSegment,
     int fromTime,
     float fromPrice,
     int toTime,
     float toPrice,
     color segmentColor,
     bool isFinal = true) =>
    // Внешняя цепочка использует тот же объект, но до одностороннего выхода
    // отрезок остаётся предварительным и не входит в подтверждённую историю.
    line confirmedSegment = developingSegment
    if na(confirmedSegment)
        confirmedSegment := line.new(
             fromTime,
             fromPrice,
             toTime,
             toPrice,
             xloc = xloc.bar_time,
             extend = extend.none,
             color = segmentColor,
             style = isFinal ? line.style_solid : line.style_dashed,
             width = structureWidth)
    else
        line.set_xy1(confirmedSegment, fromTime, fromPrice)
        line.set_xy2(confirmedSegment, toTime, toPrice)
        line.set_color(confirmedSegment, segmentColor)
        line.set_style(confirmedSegment, isFinal ? line.style_solid : line.style_dashed)
        line.set_width(confirmedSegment, structureWidth)
    if isFinal
        f_storeSegment(confirmedSegment)
    confirmedSegment

f_newDevelopingSegment(
     int fromTime,
     float fromPrice,
     int toTime,
     float toPrice,
     color segmentColor) =>
    line.new(
         fromTime,
         fromPrice,
         toTime,
         toPrice,
         xloc = xloc.bar_time,
         extend = extend.none,
         color = segmentColor,
         style = line.style_dashed,
         width = structureWidth)

//------------------------------------------------------------------------------
// Состояние структуры
// direction: 1 = рост, -1 = падение, 0 = ожидание автозапуска.
// motherHigh и motherLow — границы материнской свечи: последней, которая
// пробила границу предыдущего диапазона. Внутренние свечи материнскую
// свечу не обновляют.
// В росте выход выше motherHigh продолжает движение, выход ниже motherLow
// запускает структурный откат. В падении правила зеркальны.
// Пробой обеих границ одной свечой — отдельный случай: старт внешней цепочки.
//------------------------------------------------------------------------------

var int direction = 0
// Направление, с которого началась ещё не разрешённая цепочка внешних свечей.
// Сохраняется до первого одностороннего выхода из активного диапазона.
var int outsideOrigin = 0
var int outsideBasePivotTime = na
var float outsideBasePivotPrice = na
var line outsideBaseLine = na
var float legExtreme = na
var int legExtremeBar = na
var int legExtremeTime = na
var float motherHigh = na
var float motherLow = na
var float lastPivotPrice = na
var int lastPivotBar = na
var int lastPivotTime = na
var line developingLine = na

// Первая свеча является начальной материнской свечой в режиме «Авто».
var float initialHigh = na
var int initialHighBar = na
var int initialHighTime = na
var float initialLow = na
var int initialLowBar = na
var int initialLowTime = na

bool turnUp = false
bool turnDown = false
// Событие переноса вершины внешней цепочки; сбрасывается на каждом расчёте.
// Не является новым структурным откатом.
int movedOutsidePivotFromBar = na
int movedOutsidePivotToBar = na
float movedOutsidePivotPrice = na
int movedOutsidePivotType = 0
// Ломаная пересчитывается на тиках; Pine rollback не сохраняет промежуточные
// откаты как закрытые бары. BOS/CHOCH по закрытию остаются в своём блоке.

if barstate.isfirst
    initialHigh := high
    initialHighBar := bar_index
    initialHighTime := time
    initialLow := low
    initialLowBar := bar_index
    initialLowTime := time

if not barstate.isfirst
    // Автозапуск: контролируем обе границы первой материнской свечи.
    if direction == 0
        bool brokeInitialHigh = high > initialHigh
        bool brokeInitialLow = low < initialLow

        int chosenDirection = 0
        if brokeInitialHigh and not brokeInitialLow
            chosenDirection := 1
        else if brokeInitialLow and not brokeInitialHigh
            chosenDirection := -1
        else if brokeInitialHigh and brokeInitialLow
            // В автозапуске входящее направление ещё неизвестно. Используем
            // сторону большего выхода как начальное направление структуры.
            float upExpansion = high - initialHigh
            float downExpansion = initialLow - low
            bool assumedLong = upExpansion >= downExpansion
            outsideBasePivotTime := assumedLong ? initialLowTime : initialHighTime
            outsideBasePivotPrice := assumedLong ? initialLow : initialHigh
            if showStructure
                outsideBaseLine := f_confirmSegment(
                     na,
                     outsideBasePivotTime,
                     outsideBasePivotPrice,
                     time,
                     assumedLong ? high : low,
                     assumedLong ? upColor : downColor,
                     false)

            // Long проходит High → Low и заканчивается плечом short.
            // Short проходит Low → High и заканчивается плечом long.
            chosenDirection := assumedLong ? -1 : 1
            direction := chosenDirection
            outsideOrigin := assumedLong ? 1 : -1
            lastPivotPrice := assumedLong ? high : low
            lastPivotBar := bar_index
            lastPivotTime := time
            legExtreme := assumedLong ? low : high
            legExtremeBar := bar_index
            legExtremeTime := time
            motherHigh := high
            motherLow := low
            turnUp := not assumedLong
            turnDown := assumedLong

        if chosenDirection == 1 and not brokeInitialLow
            direction := 1
            lastPivotPrice := initialLow
            lastPivotBar := initialLowBar
            lastPivotTime := initialLowTime
            legExtreme := high
            legExtremeBar := bar_index
            legExtremeTime := time
            motherHigh := high
            motherLow := low
        else if chosenDirection == -1 and not brokeInitialHigh
            direction := -1
            lastPivotPrice := initialHigh
            lastPivotBar := initialHighBar
            lastPivotTime := initialHighTime
            legExtreme := low
            legExtremeBar := bar_index
            legExtremeTime := time
            motherHigh := high
            motherLow := low

    else
        bool brokeMotherHigh = high > motherHigh
        bool brokeMotherLow = low < motherLow

        // Только односторонний выход завершает внешнюю цепочку. Фиксируем
        // её базовый отрезок до обработки нового плеча и сброса ссылки.
        // Внутренняя или очередная внешняя свеча оставляет его пунктирным.
        if outsideOrigin != 0 and brokeMotherHigh != brokeMotherLow and not na(outsideBaseLine)
            line.set_style(outsideBaseLine, line.style_solid)
            f_storeSegment(outsideBaseLine)

        if brokeMotherHigh and brokeMotherLow
            // Пока не было одностороннего выхода, новая внешняя свеча заменяет
            // предыдущую. Промежуточные зигзаги в структуру не добавляются.
            bool continuingOutsideChain = outsideOrigin != 0
            int pathDirection = continuingOutsideChain ? outsideOrigin : direction

            // Сохраняем старый индекс до изменения lastPivotBar. Перенос данных
            // выполняется независимо от видимости ломаной, после роста массивов.
            if continuingOutsideChain
                movedOutsidePivotFromBar := lastPivotBar
                movedOutsidePivotToBar := bar_index
                movedOutsidePivotPrice := pathDirection == 1 ? high : low
                movedOutsidePivotType := pathDirection

            if not continuingOutsideChain
                outsideOrigin := direction
                outsideBasePivotTime := lastPivotTime
                outsideBasePivotPrice := lastPivotPrice

                if showStructure
                    line baseSegment = showDevelopingLeg ? developingLine : na
                    outsideBaseLine := f_confirmSegment(
                         baseSegment,
                         outsideBasePivotTime,
                         outsideBasePivotPrice,
                         time,
                         pathDirection == 1 ? high : low,
                         pathDirection == 1 ? upColor : downColor,
                         false)
                    developingLine := na

                if pathDirection == 1
                    turnDown := true
                else
                    turnUp := true
            else if showStructure
                // Удаляем только противоположное формирующееся плечо прошлой
                // внешней свечи. Базовый отрезок переносим на последнюю свечу.
                if not na(developingLine)
                    line.delete(developingLine)
                    developingLine := na

                if not na(outsideBaseLine)
                    line.set_xy1(outsideBaseLine, outsideBasePivotTime, outsideBasePivotPrice)
                    line.set_xy2(outsideBaseLine, time, pathDirection == 1 ? high : low)
                    line.set_color(outsideBaseLine, pathDirection == 1 ? upColor : downColor)
                    line.set_style(outsideBaseLine, line.style_dashed)
                    line.set_width(outsideBaseLine, structureWidth)

            if pathDirection == 1
                lastPivotPrice := high
                lastPivotBar := bar_index
                lastPivotTime := time
                direction := -1
                legExtreme := low
                legExtremeBar := bar_index
                legExtremeTime := time
            else
                lastPivotPrice := low
                lastPivotBar := bar_index
                lastPivotTime := time
                direction := 1
                legExtreme := high
                legExtremeBar := bar_index
                legExtremeTime := time

            motherHigh := high
            motherLow := low

        else if direction == 1
            if brokeMotherLow
                float turnPrice = legExtreme
                int turnBar = legExtremeBar
                int turnTime = legExtremeTime

                if showStructure
                    line segmentToConfirm = showDevelopingLeg ? developingLine : na
                    f_confirmSegment(segmentToConfirm, lastPivotTime, lastPivotPrice, turnTime, turnPrice, upColor)
                    developingLine := na

                lastPivotPrice := turnPrice
                lastPivotBar := turnBar
                lastPivotTime := turnTime
                direction := -1
                legExtreme := low
                legExtremeBar := bar_index
                legExtremeTime := time
                motherHigh := high
                motherLow := low
                turnDown := true
                outsideOrigin := 0
                outsideBasePivotTime := na
                outsideBasePivotPrice := na
                outsideBaseLine := na
            else if brokeMotherHigh
                legExtreme := high
                legExtremeBar := bar_index
                legExtremeTime := time
                motherHigh := high
                motherLow := low
                outsideOrigin := 0
                outsideBasePivotTime := na
                outsideBasePivotPrice := na
                outsideBaseLine := na

        else if direction == -1
            if brokeMotherHigh
                float turnPrice = legExtreme
                int turnBar = legExtremeBar
                int turnTime = legExtremeTime

                if showStructure
                    line segmentToConfirm = showDevelopingLeg ? developingLine : na
                    f_confirmSegment(segmentToConfirm, lastPivotTime, lastPivotPrice, turnTime, turnPrice, downColor)
                    developingLine := na

                lastPivotPrice := turnPrice
                lastPivotBar := turnBar
                lastPivotTime := turnTime
                direction := 1
                legExtreme := high
                legExtremeBar := bar_index
                legExtremeTime := time
                motherHigh := high
                motherLow := low
                turnUp := true
                outsideOrigin := 0
                outsideBasePivotTime := na
                outsideBasePivotPrice := na
                outsideBaseLine := na
            else if brokeMotherLow
                legExtreme := low
                legExtremeBar := bar_index
                legExtremeTime := time
                motherHigh := high
                motherLow := low
                outsideOrigin := 0
                outsideBasePivotTime := na
                outsideBasePivotPrice := na
                outsideBaseLine := na

// Формирующееся плечо рисуется пунктиром. После подтверждения тот же объект
// становится сплошным, а новое плечо снова начинается пунктиром.
if showStructure and showDevelopingLeg and direction != 0 and not na(lastPivotPrice) and not na(legExtreme)
    if na(developingLine)
        developingLine := f_newDevelopingSegment(
             lastPivotTime,
             lastPivotPrice,
             legExtremeTime,
             legExtreme,
             direction == 1 ? upColor : downColor)
    else
        line.set_xy1(developingLine, lastPivotTime, lastPivotPrice)
        line.set_xy2(developingLine, legExtremeTime, legExtreme)
        line.set_color(developingLine, direction == 1 ? upColor : downColor)
        line.set_style(developingLine, line.style_dashed)
        line.set_width(developingLine, structureWidth)

//------------------------------------------------------------------------------
// Структура рынка
//
// Фаза 1: сохраняем всю доступную историю и текущие структурные повороты
// первого урока, включая переносимую вершину внешней цепочки.
// Фаза 2: при инициализации и закрытии свечи ретроспективно выбираем более
// поздний исторический экстремум и воспроизводим переходы до текущей свечи.
//
// Правила:
// • старт — от абсолютных MAX/MIN всей загруженной истории, сторона — по более
//   позднему экстремуму; при изменении глубины истории уровни могут переехать;
// • IDM — ближайший противоположный пивот; снятие IDM строго раньше закрытия тела;
// • тень, вышедшая за триггер без закрытия тела, подтягивает уровень: BOS и CHOCH
//   фиксируются только закрытием тела за максимумом или минимумом теней;
// • закрытие за ключевым MAX/MIN создаёт кандидата BOS. Прежние BOS/CHOCH
//   сохраняются до снятия IDM следующего MAX/MIN, затем обновляются вместе;
// • CHOCH — экстремум между точкой подтверждённого BOS и ключевым MAX/MIN;
// • если предыдущего ключевого экстремума нет — режим «только диапазон»:
//   показываются MAX/MIN графика, структура не определена.
//------------------------------------------------------------------------------

var array<float> marketBarHigh = array.new_float()
var array<float> marketBarLow = array.new_float()
var array<float> marketBarClose = array.new_float()
var array<int> marketBarTime = array.new_int()
var array<float> marketPivotHigh = array.new_float()
var array<float> marketPivotLow = array.new_float()
var array<bool> marketRecordHigh = array.new_bool()
var array<bool> marketRecordLow = array.new_bool()
// Барные индексы только рекордных pivot, по возрастанию. Поиск старого BOS
// перебирает эти редкие кандидаты вместо всех исторических свечей.
var array<int> marketHighRecordBars = array.new_int()
var array<int> marketLowRecordBars = array.new_int()
// Индекс последнего pivot строго слева; перестраивается вместе с replay.
var array<int> marketPreviousHighBar = array.new_int()
var array<int> marketPreviousLowBar = array.new_int()

// Каждый следующий слой объединяет пары High/Low предыдущего. Нижний слой
// ссылается на сырые свечи, отдельные массивы никогда не превышают 100 000.
type MarketRangeLayer
    array<float> highs
    array<float> lows
    int endBar

var array<MarketRangeLayer> marketRangeLayers = array.new<MarketRangeLayer>()

// Следующее закрытие за цепочкой теней. Индекс хранится справа налево:
// позиция array.size(...) - 1 - bar соответствует исходной свече bar.
var array<int> marketBodyHighNext = array.new_int()
var array<int> marketBodyLowNext = array.new_int()

if enableMarketStructure and bar_index == array.size(marketBarHigh)
    array.push(marketBarHigh, high)
    array.push(marketBarLow, low)
    array.push(marketBarClose, close)
    array.push(marketBarTime, time)
    array.push(marketPivotHigh, na)
    array.push(marketPivotLow, na)
else if enableMarketStructure and bar_index < array.size(marketBarHigh)
    array.set(marketBarHigh, bar_index, high)
    array.set(marketBarLow, bar_index, low)
    array.set(marketBarClose, bar_index, close)
    array.set(marketBarTime, bar_index, time)

// Массивы уже содержат текущую свечу. Переносим только соответствующий тип
// вершины: противоположная структурная точка на старой свече сохраняется.
if enableMarketStructure and movedOutsidePivotType != 0 and not na(movedOutsidePivotFromBar) and not na(movedOutsidePivotToBar)
    array<float> movedPivotArray = movedOutsidePivotType == 1 ? marketPivotHigh : marketPivotLow
    if movedOutsidePivotFromBar >= 0 and movedOutsidePivotFromBar < array.size(movedPivotArray) and movedOutsidePivotToBar >= 0 and movedOutsidePivotToBar < array.size(movedPivotArray)
        array.set(movedPivotArray, movedOutsidePivotFromBar, na)
        array.set(movedPivotArray, movedOutsidePivotToBar, movedOutsidePivotPrice)

if enableMarketStructure and turnDown and not na(lastPivotBar) and lastPivotBar >= 0 and lastPivotBar < array.size(marketPivotHigh)
    array.set(marketPivotHigh, lastPivotBar, lastPivotPrice)

if enableMarketStructure and turnUp and not na(lastPivotBar) and lastPivotBar >= 0 and lastPivotBar < array.size(marketPivotLow)
    array.set(marketPivotLow, lastPivotBar, lastPivotPrice)

f_marketBuildRangeIndex() =>
    array.clear(marketRangeLayers)
    array.push(marketRangeLayers, MarketRangeLayer.new(marketBarHigh, marketBarLow, array.size(marketBarHigh) - 1))
    int count = array.size(marketBarHigh)
    int layerIndex = 0
    while count > 1
        MarketRangeLayer child = array.get(marketRangeLayers, layerIndex)
        array<float> highs = array.new<float>()
        array<float> lows = array.new<float>()
        int childIndex = 0
        while childIndex < count
            float combinedHigh = array.get(child.highs, childIndex)
            float combinedLow = array.get(child.lows, childIndex)
            if childIndex + 1 < count
                combinedHigh := math.max(combinedHigh, array.get(child.highs, childIndex + 1))
                combinedLow := math.min(combinedLow, array.get(child.lows, childIndex + 1))
            array.push(highs, combinedHigh)
            array.push(lows, combinedLow)
            childIndex += 2
        array.push(marketRangeLayers, MarketRangeLayer.new(highs, lows, int(na)))
        count := array.size(highs)
        layerIndex += 1
    count

// Иерархию экстремумов наращиваем по одной свече. При первом вызове
// строим все имеющиеся узлы, затем обновляем только последний узел слоя.
// Размер следующего слоя берём из его массива после записи пары High/Low.
f_marketAppendRangeIndex() =>
    int barCount = array.size(marketBarHigh)
    if barCount > 0
        if array.size(marketRangeLayers) == 0
            f_marketBuildRangeIndex()
        MarketRangeLayer base = array.get(marketRangeLayers, 0)
        // Базовый слой всегда ссылается на текущие исходные массивы.
        base.highs := marketBarHigh
        base.lows := marketBarLow
        base.endBar := barCount - 1
        int levelCount = array.size(base.highs)
        int level = 0
        while levelCount > 1
            MarketRangeLayer child = array.get(marketRangeLayers, level)
            int parentIndex = math.floor((levelCount - 1) / 2)
            int leftIndex = parentIndex * 2
            float combinedHigh = array.get(child.highs, leftIndex)
            float combinedLow = array.get(child.lows, leftIndex)
            if leftIndex + 1 < levelCount
                combinedHigh := math.max(combinedHigh, array.get(child.highs, leftIndex + 1))
                combinedLow := math.min(combinedLow, array.get(child.lows, leftIndex + 1))
            if level + 1 >= array.size(marketRangeLayers)
                array.push(marketRangeLayers, MarketRangeLayer.new(array.new_float(), array.new_float(), int(na)))
            MarketRangeLayer parent = array.get(marketRangeLayers, level + 1)
            if parentIndex == array.size(parent.highs)
                array.push(parent.highs, combinedHigh)
                array.push(parent.lows, combinedLow)
            else
                array.set(parent.highs, parentIndex, combinedHigh)
                array.set(parent.lows, parentIndex, combinedLow)
            levelCount := array.size(parent.highs)
            level += 1
    barCount

// На истории стоимость построения распределяется между свечами.
// Включён только для отдельной структуры BOS/CHOCH, в её исходной истории.
if enableMarketStructure
    f_marketAppendRangeIndex()

// Первый строгий выход High выше уровня или Low ниже него. Пропускаем целые
// блоки без пробоя и спускаемся только внутри первого подходящего блока.
// Если появилась открытая свеча после построения индекса, её хвост проверяется
// отдельно: старшие слои не читаются за пределами индексированной истории.
f_marketFirstCross(int pointType, int fromBar, int endBar, float level) =>
    int result = na
    if not na(level) and not na(fromBar) and not na(endBar)
        int start = math.max(0, fromBar)
        int finish = math.min(endBar, array.size(marketBarHigh) - 1)
        int indexedEnd = -1
        if array.size(marketRangeLayers) > 0
            MarketRangeLayer baseLayer = array.get(marketRangeLayers, 0)
            indexedEnd := math.min(finish, baseLayer.endBar)
        int searchBar = start
        while searchBar <= indexedEnd and array.size(marketRangeLayers) > 0 and na(result)
            int layerIndex = 0
            int blockSize = 1
            while layerIndex + 1 < array.size(marketRangeLayers) and searchBar % (blockSize * 2) == 0 and searchBar + blockSize * 2 - 1 <= indexedEnd
                layerIndex += 1
                blockSize := blockSize * 2
            MarketRangeLayer layer = array.get(marketRangeLayers, layerIndex)
            float extreme = pointType == 1 ? array.get(layer.highs, int(searchBar / blockSize)) : array.get(layer.lows, int(searchBar / blockSize))
            bool crossed = pointType == 1 ? extreme > level : extreme < level
            if crossed
                while layerIndex > 0
                    layerIndex -= 1
                    blockSize := int(blockSize / 2)
                    MarketRangeLayer child = array.get(marketRangeLayers, layerIndex)
                    float leftExtreme = pointType == 1 ? array.get(child.highs, int(searchBar / blockSize)) : array.get(child.lows, int(searchBar / blockSize))
                    bool leftCrossed = pointType == 1 ? leftExtreme > level : leftExtreme < level
                    if not leftCrossed
                        searchBar += blockSize
                result := searchBar
            else
                searchBar += blockSize
        int tailBar = math.max(start, indexedEnd + 1)
        while tailBar <= finish and na(result)
            float shadow = pointType == 1 ? array.get(marketBarHigh, tailBar) : array.get(marketBarLow, tailBar)
            bool crossed = pointType == 1 ? shadow > level : shadow < level
            if crossed
                result := tailBar
            tailBar += 1
    result

f_marketPointIdm(int pointBar, int pointType, int endBar) =>
    float idmValue = na
    int idmBar = na
    int sweepBar = na
    int previousPivotBar = na
    if not na(pointBar) and pointBar >= 0 and pointBar < array.size(marketPreviousLowBar)
        previousPivotBar := pointType == 1 ? array.get(marketPreviousLowBar, pointBar) : array.get(marketPreviousHighBar, pointBar)
    if not na(previousPivotBar)
        idmBar := previousPivotBar
        idmValue := pointType == 1 ? array.get(marketPivotLow, previousPivotBar) : array.get(marketPivotHigh, previousPivotBar)

    if not na(idmValue)
        sweepBar := f_marketFirstCross(-pointType, pointBar + 1, endBar, idmValue)

    [idmValue, idmBar, sweepBar]

// Каждый элемент вычисляется один раз. После первого выхода тенью без
// закрытия дальнейший результат совпадает с результатом для этой новой тени.
// Монотонные стеки находят первую строго более высокую/низкую тень справа.
// Это исключает повторный проход по одним свечам для каждого прошлого pivot.
f_marketBuildBodyIndex() =>
    array.clear(marketBodyHighNext)
    array.clear(marketBodyLowNext)
    array<int> highStack = array.new<int>()
    array<int> lowStack = array.new<int>()
    int indexedEnd = array.size(marketBarHigh) - 1
    int sourceBar = indexedEnd
    while sourceBar >= 0
        float sourceHigh = array.get(marketBarHigh, sourceBar)
        float sourceLow = array.get(marketBarLow, sourceBar)
        while array.size(highStack) > 0 and array.get(marketBarHigh, array.last(highStack)) <= sourceHigh
            array.remove(highStack, array.size(highStack) - 1)
        while array.size(lowStack) > 0 and array.get(marketBarLow, array.last(lowStack)) >= sourceLow
            array.remove(lowStack, array.size(lowStack) - 1)
        int highBreak = na
        int lowBreak = na
        if array.size(highStack) > 0
            int nextHigh = array.last(highStack)
            highBreak := array.get(marketBarClose, nextHigh) > sourceHigh ? nextHigh : array.get(marketBodyHighNext, indexedEnd - nextHigh)
        if array.size(lowStack) > 0
            int nextLow = array.last(lowStack)
            lowBreak := array.get(marketBarClose, nextLow) < sourceLow ? nextLow : array.get(marketBodyLowNext, indexedEnd - nextLow)
        array.push(marketBodyHighNext, highBreak)
        array.push(marketBodyLowNext, lowBreak)
        array.push(highStack, sourceBar)
        array.push(lowStack, sourceBar)
        sourceBar -= 1
    indexedEnd

// Ключевой экстремум и его пробой — два последовательных события. Сначала
// должен быть снят собственный IDM. Затем только закрытие тела за текущим
// уровнем создаёт кандидата BOS; для его фиксации нужен следующий ключевой
// MAX/MIN. Выход одной тенью переносит проверяемый уровень на High/Low тени.
f_marketBodyBreakAfterIdm(int pointType, float pointValue, int idmSweepBar, int endBar) =>
    int breakBar = na
    int searchBar = idmSweepBar + 1
    float triggerValue = pointValue

    int indexedEnd = array.size(marketBodyHighNext) - 1
    bool bodyIndexReady = indexedEnd >= endBar and array.size(marketBodyLowNext) == indexedEnd + 1
    if bodyIndexReady
        int firstCross = f_marketFirstCross(pointType, searchBar, endBar, pointValue)
        if not na(firstCross)
            float firstClose = array.get(marketBarClose, firstCross)
            bool bodyBreak = pointType == 1 ? firstClose > pointValue : firstClose < pointValue
            int indexedBreak = bodyBreak ? firstCross : array.get(pointType == 1 ? marketBodyHighNext : marketBodyLowNext, indexedEnd - firstCross)
            // Индекс построен на всей доступной истории, но запрос не получает
            // закрытие правее endBar, в том числе с ещё открытой свечи.
            if not na(indexedBreak) and indexedBreak <= endBar
                breakBar := indexedBreak
    else
        // Без индекса или для добавленной справа свечи сохраняем точный
        // линейный поиск. Основной replay всегда предварительно строит индекс.
        while searchBar <= endBar and na(breakBar)
            float testedClose = array.get(marketBarClose, searchBar)
            bool bodyBreak = pointType == 1 ? testedClose > triggerValue : testedClose < triggerValue
            if bodyBreak
                breakBar := searchBar
            else
                float testedShadow = pointType == 1 ? array.get(marketBarHigh, searchBar) : array.get(marketBarLow, searchBar)
                bool shadowBreak = pointType == 1 ? testedShadow > triggerValue : testedShadow < triggerValue
                if shadowBreak
                    triggerValue := testedShadow
            searchBar += 1

    breakBar

// Восстанавливает ступени уже найденного BOS. Свеча, закрывшаяся телом за
// текущим уровнем, завершает линию и своим High/Low новую ступень не создаёт.
f_marketBuildBosSteps(
     int pointType,
     float pointValue,
     int idmSweepBar,
     int breakBar,
     array<int> targetBars,
     array<float> targetValues) =>
    array.clear(targetBars)
    array.clear(targetValues)
    float triggerValue = pointValue
    int searchBar = idmSweepBar + 1

    // Ищем следующий строгий выход тенью через индекс диапазонов и пропускаем
    // свечи без изменений. Если выходы идут почти на каждой свече, переходим
    // к прежнему линейному проходу: он быстрее на плотной серии ступеней BOS.
    // Свеча breakBar по-прежнему не включается в ступени.
    int denseCrosses = 0
    bool useRangeIndex = true
    while searchBar < breakBar
        if useRangeIndex
            int crossedBar = f_marketFirstCross(pointType, searchBar, breakBar - 1, triggerValue)
            if na(crossedBar)
                break
            denseCrosses := crossedBar - searchBar <= 2 ? denseCrosses + 1 : 0
            if denseCrosses >= 8
                useRangeIndex := false
            triggerValue := pointType == 1 ? array.get(marketBarHigh, crossedBar) : array.get(marketBarLow, crossedBar)
            array.push(targetBars, crossedBar)
            array.push(targetValues, triggerValue)
            searchBar := crossedBar + 1
        else
            float testedShadow = pointType == 1 ? array.get(marketBarHigh, searchBar) : array.get(marketBarLow, searchBar)
            bool shadowBreak = pointType == 1 ? testedShadow > triggerValue : testedShadow < triggerValue
            if shadowBreak
                triggerValue := testedShadow
                array.push(targetBars, searchBar)
                array.push(targetValues, triggerValue)
            searchBar += 1

    triggerValue

// При ретроспективном запуске High/Low — это не любой внутренний поворот.
// High должен обновлять все предшествующие свечные High, а Low — все
// предшествующие свечные Low. Сравнение со всей сырой историей также исключает
// ложные рекорды, появившиеся из-за первой неполной структурной ножки.
f_marketIsStructuralRecord(int pointType, int pointBar) =>
    pointType == 1 ? array.get(marketRecordHigh, pointBar) : array.get(marketRecordLow, pointBar)

// Идёт хронологически назад по структурным High/Low. Кандидат обязан сначала
// снять свой IDM, а затем быть пробит телом. Если последовательность не
// подтверждена, поиск продолжается дальше влево до начала истории.
f_marketPreviousKeyRecord(int pointType, int beforeBar, float breakerValue, int endBar) =>
    float resultValue = na
    int resultBar = na
    float resultIdm = na
    int resultIdmBar = na
    int resultSweepBar = na
    int resultBreakBar = na
    // Все рекордные pivots хранятся по возрастанию индекса. Перебираем только
    // их, в том же порядке справа налево, что и прежний проход по всем свечам.
    array<int> recordBars = pointType == 1 ? marketHighRecordBars : marketLowRecordBars
    int recordCursor = array.size(recordBars) - 1
    while recordCursor >= 0 and array.get(recordBars, recordCursor) >= beforeBar
        recordCursor -= 1

    while recordCursor >= 0 and na(resultBar)
        int searchBar = array.get(recordBars, recordCursor)
        float testedPivot = pointType == 1 ? array.get(marketPivotHigh, searchBar) : array.get(marketPivotLow, searchBar)
        bool isActuallyBroken = pointType == 1 ? testedPivot < breakerValue : testedPivot > breakerValue

        if isActuallyBroken
            [testedIdm, testedIdmBar, testedSweepBar] = f_marketPointIdm(searchBar, pointType, endBar)
            int testedBreakBar = not na(testedIdm) and not na(testedSweepBar) ? f_marketBodyBreakAfterIdm(pointType, testedPivot, testedSweepBar, endBar) : na
            if not na(testedBreakBar)
                resultValue := testedPivot
                resultBar := searchBar
                resultIdm := testedIdm
                resultIdmBar := testedIdmBar
                resultSweepBar := testedSweepBar
                resultBreakBar := testedBreakBar

        recordCursor -= 1

    [resultValue, resultBar, resultIdm, resultIdmBar, resultSweepBar, resultBreakBar]

f_marketInitialSide(int pointType, float extremeValue, int extremeBar) =>
    // Абсолютный MAX/MIN графика является текущей границей диапазона. Для
    // запуска структуры ему не требуется предварительно снимать собственный
    // IDM: ключевой статус проверяем у предыдущего экстремума, который этот MAX/MIN
    // уже пробил.
    float previousValue = na
    int previousBar = na
    float previousIdm = na
    int previousIdmBar = na
    int previousSweepBar = na
    int previousBreakBar = na

    // Предыдущий High/Low должен быть ключевым уже к моменту выбранного
    // абсолютного MAX/MIN. Свечи справа от абсолютного экстремума не могут
    // задним числом снять IDM промежуточного поворота и превратить его в BOS.
    [foundValue, foundBar, foundIdm, foundIdmBar, foundSweepBar, foundBreakBar] = f_marketPreviousKeyRecord(pointType, extremeBar, extremeValue, extremeBar)
    previousValue := foundValue
    previousBar := foundBar
    previousIdm := foundIdm
    previousIdmBar := foundIdmBar
    previousSweepBar := foundSweepBar
    previousBreakBar := foundBreakBar

    bool sideReady = not na(previousBar) and not na(previousBreakBar)
    [sideReady, previousValue, previousBar, previousIdm, previousIdmBar, previousSweepBar, previousBreakBar]

f_marketRangePoint(int fromBar, int toBar, int pointType) =>
    float pointValue = na
    int pointBar = na
    int rangeStart = math.max(0, math.min(fromBar, toBar))
    int rangeEnd = math.min(array.size(marketBarHigh) - 1, math.max(fromBar, toBar))
    int rangeBar = rangeStart

    while rangeBar <= rangeEnd
        float testedValue = pointType == 1 ? array.get(marketBarHigh, rangeBar) : array.get(marketBarLow, rangeBar)
        bool replacesPoint = na(pointValue) or pointType == 1 and testedValue >= pointValue or pointType == -1 and testedValue <= pointValue
        if replacesPoint
            pointValue := testedValue
            pointBar := rangeBar
        rangeBar += 1

    [pointValue, pointBar]

// Свеча снятия IDM подтверждает ключевой MAX/MIN, но не расширяет участок
// выбора CHOCH за свечу самого экстремума. IDM CHOCH проверяется отдельно.
f_marketChochForKey(int bosBar, int extremeBar, int direction, int endBar) =>
    [pointValue, pointBar] = f_marketRangePoint(bosBar, extremeBar, -direction)
    [idmValue, idmBar, sweepBar] = f_marketPointIdm(pointBar, -direction, endBar)
    [pointValue, pointBar, idmValue, idmBar, sweepBar]

// Контекстный поиск начинается заново после конкретной свечи пробоя.
// Текущий кандидат MAX/MIN обновляется по сырым High/Low каждой свечи, поэтому
// отображается сразу, не дожидаясь подтверждённого поворота ломаной. Ключевым
// он становится только после последующего снятия закреплённого за ним IDM.
f_marketFindNextKey(int pointType, int afterBar, int endBar) =>
    float lastOppositePivot = na
    int lastOppositePivotBar = na
    // Первый кандидат опирается на pivot строго перед свечой пробоя.
    int seedBar = na
    if not na(afterBar) and afterBar >= 0 and afterBar < array.size(marketPreviousLowBar)
        seedBar := pointType == 1 ? array.get(marketPreviousLowBar, afterBar) : array.get(marketPreviousHighBar, afterBar)
    if not na(seedBar)
        lastOppositePivot := pointType == 1 ? array.get(marketPivotLow, seedBar) : array.get(marketPivotHigh, seedBar)
        lastOppositePivotBar := seedBar

    float candidateValue = na
    int candidateBar = na
    float candidateIdm = na
    int candidateIdmBar = na
    int candidateSweepBar = na
    // Свеча пробоя одновременно может быть первой точкой нового MAX/MIN.
    int searchBar = afterBar

    while searchBar <= endBar and na(candidateSweepBar)
        float oppositePivot = pointType == 1 ? array.get(marketPivotLow, searchBar) : array.get(marketPivotHigh, searchBar)
        float sameSideValue = pointType == 1 ? array.get(marketBarHigh, searchBar) : array.get(marketBarLow, searchBar)

        // IDM кандидата берём только из пивотов СТРОГО ЛЕВЕЕ его свечи.
        bool replacesCandidate = not na(lastOppositePivot) and not na(lastOppositePivotBar) and lastOppositePivotBar < searchBar and (na(candidateValue) or pointType == 1 and sameSideValue > candidateValue or pointType == -1 and sameSideValue < candidateValue)
        if replacesCandidate
            candidateValue := sameSideValue
            candidateBar := searchBar
            candidateIdm := lastOppositePivot
            candidateIdmBar := lastOppositePivotBar

        if not na(candidateValue) and searchBar > candidateBar
            bool removesIdm = pointType == 1 ? array.get(marketBarLow, searchBar) < candidateIdm : array.get(marketBarHigh, searchBar) > candidateIdm
            if removesIdm
                candidateSweepBar := searchBar

        // Пивот текущей свечи доступен как IDM только начиная со следующей свечи.
        if not na(oppositePivot)
            lastOppositePivot := oppositePivot
            lastOppositePivotBar := searchBar

        searchBar += 1

    [candidateValue, candidateBar, candidateIdm, candidateIdmBar, candidateSweepBar]

f_marketTime(int targetBar) =>
    not na(targetBar) and targetBar >= 0 and targetBar < array.size(marketBarTime) ? array.get(marketBarTime, targetBar) : time

f_marketCopySteps(array<int> sourceBars, array<float> sourceValues, array<int> targetBars, array<float> targetValues) =>
    array.clear(targetBars)
    array.clear(targetValues)
    int stepIndex = 0
    while stepIndex < array.size(sourceBars)
        array.push(targetBars, array.get(sourceBars, stepIndex))
        array.push(targetValues, array.get(sourceValues, stepIndex))
        stepIndex += 1

// До 100 000 ступеней в массиве: максимум 21 часть на уровень, 63 на три.
// Общая точка соседних частей сохраняет непрерывность без потери ступеней.
f_marketStepPolyline(array<polyline> targetPolylines, int originBar, float originValue, array<int> stepBars, array<float> stepValues, int endTime, color lineColor, int lineWidth) =>
    array<chart.point> points = array.new<chart.point>()
    array.push(points, chart.point.from_time(f_marketTime(originBar), originValue))
    float previousValue = originValue
    int stepIndex = 0

    while stepIndex < array.size(stepBars)
        // Оставляем место для двух точек ступени и конечной точки.
        if array.size(points) + 3 > 10000
            array.push(targetPolylines, polyline.new(points, curved = false, closed = false, xloc = xloc.bar_time, line_color = lineColor, line_width = lineWidth))
            chart.point joinPoint = array.get(points, array.size(points) - 1)
            array.clear(points)
            array.push(points, joinPoint)
        int stepTime = f_marketTime(array.get(stepBars, stepIndex))
        float stepValue = array.get(stepValues, stepIndex)
        array.push(points, chart.point.from_time(stepTime, previousValue))
        array.push(points, chart.point.from_time(stepTime, stepValue))
        previousValue := stepValue
        stepIndex += 1

    array.push(points, chart.point.from_time(endTime, previousValue))
    array.push(targetPolylines, polyline.new(points, curved = false, closed = false, xloc = xloc.bar_time, line_color = lineColor, line_width = lineWidth))

// Пробитый ключевой экстремум ещё не является новым BOS: сохраняем его
// отдельно до подтверждения следующего MAX/MIN. Ступени копируются по значению.
type MarketBosState
    float value
    float triggerValue
    int pointBar
    int breakBar
    float idm
    int idmBar
    int idmSweepBar
    array<int> stepBars
    array<float> stepValues

// Актуальное состояние после полного ретроспективного прохода.
var bool marketReady = false
var bool marketHasExtreme = false
var bool marketRangeOnly = false
var int marketDirection = 0
var string marketStatusText = "Ожидание истории"
var string marketStartText = ""
var float marketChartMaximum = na
var int marketChartMaximumBar = na
var float marketChartMinimum = na
var int marketChartMinimumBar = na

var float marketBosValue = na
var float marketBosTriggerValue = na
var int marketBosBar = na
var int marketBosBreakBar = na
var float marketBosIdm = na
var int marketBosIdmBar = na
var int marketBosIdmSweepBar = na
var MarketBosState marketPendingBos = na

var float marketChochValue = na
var float marketChochTriggerValue = na
var int marketChochBar = na
var float marketChochIdm = na
var int marketChochIdmBar = na
var int marketChochIdmSweepBar = na
var bool marketChochPending = false

var float marketExtremeValue = na
var float marketExtremeTriggerValue = na
var int marketExtremeBar = na
var float marketExtremeIdm = na
var int marketExtremeIdmBar = na
var int marketExtremeIdmSweepBar = na

var array<int> marketBosStepBars = array.new_int()
var array<float> marketBosStepValues = array.new_float()
var array<int> marketChochStepBars = array.new_int()
var array<float> marketChochStepValues = array.new_float()
var array<int> marketExtremeStepBars = array.new_int()
var array<float> marketExtremeStepValues = array.new_float()

// Подтверждённый результат сохраняется между свечами. Обычный var позволяет
// Pine откатить предварительные изменения текущего тика перед следующим.
var int marketReplayEndBar = na
var float pendingOppositePivot = na
var int pendingOppositePivotBar = na

// Первичная инициализация — на последней исторической закрытой свече.
// Далее полный проход нужен только на закрытии текущей свечи.
bool marketNeedsReplay = enableMarketStructure and (barstate.islastconfirmedhistory or (barstate.islast and barstate.isconfirmed))
if marketNeedsReplay
    marketReady := false
    marketHasExtreme := false
    marketRangeOnly := false
    marketDirection := 0
    marketStatusText := "Недостаточно данных для инициализации"
    marketStartText := ""
    marketChartMaximum := na
    marketChartMaximumBar := na
    marketChartMinimum := na
    marketChartMinimumBar := na
    marketBosValue := na
    marketBosTriggerValue := na
    marketBosBar := na
    marketBosBreakBar := na
    marketBosIdm := na
    marketBosIdmBar := na
    marketBosIdmSweepBar := na
    marketPendingBos := na
    marketChochValue := na
    marketChochTriggerValue := na
    marketChochBar := na
    marketChochIdm := na
    marketChochIdmBar := na
    marketChochIdmSweepBar := na
    marketChochPending := false
    marketExtremeValue := na
    marketExtremeTriggerValue := na
    marketExtremeBar := na
    marketExtremeIdm := na
    marketExtremeIdmBar := na
    marketExtremeIdmSweepBar := na
    pendingOppositePivot := na
    pendingOppositePivotBar := na
    array.clear(marketBosStepBars)
    array.clear(marketBosStepValues)
    array.clear(marketChochStepBars)
    array.clear(marketChochStepValues)
    array.clear(marketExtremeStepBars)
    array.clear(marketExtremeStepValues)
    // Незакрытая последняя свеча полностью исключена: до закрытия не
    // учитываются ни её High/Low, ни текущее значение Close.
    int historyEndBar = array.size(marketBarHigh) - (barstate.isconfirmed ? 1 : 2)
    int bodyEndBar = historyEndBar
    marketReplayEndBar := historyEndBar
    // Строится один раз на полный пересчёт. Переносы внешних пивотов уже
    // учтены в массивах; индекс не кеширует принадлежность IDM или пивота.
    // Резервный путь на случай отсутствия инкрементального индекса.
    if array.size(marketRangeLayers) == 0
        f_marketBuildRangeIndex()
    f_marketBuildBodyIndex()

    // Один линейный проход заранее отмечает только рекордные структурные
    // High/Low. Это сохраняет скорость на минутной истории: последующий поиск
    // BOS больше не пересматривает весь график для каждого локального поворота.
    array.clear(marketRecordHigh)
    array.clear(marketRecordLow)
    array.clear(marketHighRecordBars)
    array.clear(marketLowRecordBars)
    array.clear(marketPreviousHighBar)
    array.clear(marketPreviousLowBar)
    int latestHighPivotBar = na
    int latestLowPivotBar = na
    float runningRawHigh = na
    float runningRawLow = na
    int recordSearchBar = 0
    while recordSearchBar <= historyEndBar
        float testedPivotHigh = array.get(marketPivotHigh, recordSearchBar)
        float testedPivotLow = array.get(marketPivotLow, recordSearchBar)
        // Записываем ДО текущих pivot: свеча не может быть собственным IDM.
        array.push(marketPreviousHighBar, latestHighPivotBar)
        array.push(marketPreviousLowBar, latestLowPivotBar)
        if not na(testedPivotHigh)
            latestHighPivotBar := recordSearchBar
        if not na(testedPivotLow)
            latestLowPivotBar := recordSearchBar
        // Сначала сравниваем pivot только со свечами строго слева от него.
        // High/Low самой свечи добавляются в накопленный рекорд уже после этого.
        bool isNewRecordHigh = not na(testedPivotHigh) and (na(runningRawHigh) or testedPivotHigh > runningRawHigh)
        bool isNewRecordLow = not na(testedPivotLow) and (na(runningRawLow) or testedPivotLow < runningRawLow)
        array.push(marketRecordHigh, isNewRecordHigh)
        array.push(marketRecordLow, isNewRecordLow)
        if isNewRecordHigh
            array.push(marketHighRecordBars, recordSearchBar)
        if isNewRecordLow
            array.push(marketLowRecordBars, recordSearchBar)
        float rawHigh = array.get(marketBarHigh, recordSearchBar)
        float rawLow = array.get(marketBarLow, recordSearchBar)
        runningRawHigh := na(runningRawHigh) ? rawHigh : math.max(runningRawHigh, rawHigh)
        runningRawLow := na(runningRawLow) ? rawLow : math.min(runningRawLow, rawLow)
        recordSearchBar += 1

    // MAX и MIN всей истории, которую TradingView загрузил для текущего
    // таймфрейма. При равной цене выбираем более позднюю свечу.
    float chartMaximum = na
    int chartMaximumBar = na
    float chartMinimum = na
    int chartMinimumBar = na
    int extremeSearchBar = 0
    while extremeSearchBar <= historyEndBar
        float testedHigh = array.get(marketBarHigh, extremeSearchBar)
        float testedLow = array.get(marketBarLow, extremeSearchBar)
        if na(chartMaximum) or testedHigh >= chartMaximum
            chartMaximum := testedHigh
            chartMaximumBar := extremeSearchBar
        if na(chartMinimum) or testedLow <= chartMinimum
            chartMinimum := testedLow
            chartMinimumBar := extremeSearchBar
        extremeSearchBar += 1

    bool initializeFromHigh = chartMaximumBar > chartMinimumBar
    marketChartMaximum := chartMaximum
    marketChartMaximumBar := chartMaximumBar
    marketChartMinimum := chartMinimum
    marketChartMinimumBar := chartMinimumBar

    [highSideReady, previousHighValue, previousHighBar, previousHighIdm, previousHighIdmBar, previousHighSweepBar, previousHighBreakBar] = f_marketInitialSide(1, chartMaximum, chartMaximumBar)
    [lowSideReady, previousLowValue, previousLowBar, previousLowIdm, previousLowIdmBar, previousLowSweepBar, previousLowBreakBar] = f_marketInitialSide(-1, chartMinimum, chartMinimumBar)

    // Сначала пробуем более позднюю границу. Если для неё нет предыдущего
    // ключевого рекорда, зеркально пробуем вторую сторону.
    bool useHighSide = initializeFromHigh ? highSideReady : not lowSideReady and highSideReady
    bool useLowSide = initializeFromHigh ? not highSideReady and lowSideReady : lowSideReady
    int replayBar = na

    if useHighSide or useLowSide
        marketDirection := useHighSide ? 1 : -1
        marketBosValue := useHighSide ? previousHighValue : previousLowValue
        marketBosBar := useHighSide ? previousHighBar : previousLowBar
        marketBosBreakBar := useHighSide ? previousHighBreakBar : previousLowBreakBar
        marketBosIdm := useHighSide ? previousHighIdm : previousLowIdm
        marketBosIdmBar := useHighSide ? previousHighIdmBar : previousLowIdmBar
        marketBosIdmSweepBar := useHighSide ? previousHighSweepBar : previousLowSweepBar
        marketBosTriggerValue := f_marketBuildBosSteps(
             marketDirection,
             marketBosValue,
             marketBosIdmSweepBar,
             marketBosBreakBar,
             marketBosStepBars,
             marketBosStepValues)

        marketPendingBos := MarketBosState.new(marketBosValue, marketBosTriggerValue, marketBosBar, marketBosBreakBar, marketBosIdm, marketBosIdmBar, marketBosIdmSweepBar, array.copy(marketBosStepBars), array.copy(marketBosStepValues))
        // Пока следующий MAX/MIN не ключевой, показываем прежние BOS и CHOCH.
        // Без более раннего подтверждённого BOS не выдумываем замену.
        [priorBosValue, priorBosBar, priorBosIdm, priorBosIdmBar, priorBosSweep, priorBosBreak] = f_marketPreviousKeyRecord(marketDirection, marketPendingBos.pointBar, marketPendingBos.value, marketPendingBos.pointBar)
        if not na(priorBosBar)
            [initialChochValue, initialChochBar, initialChochIdm, initialChochIdmBar, initialChochSweep] = f_marketChochForKey(priorBosBar, marketPendingBos.pointBar, marketDirection, marketPendingBos.breakBar)
            marketChochValue := initialChochValue
            marketChochBar := initialChochBar
            marketChochIdm := initialChochIdm
            marketChochIdmBar := initialChochIdmBar
            marketChochIdmSweepBar := initialChochSweep
            // Учитываем прежние выносы тенью до текущего BOS включительно.
            marketChochTriggerValue := f_marketBuildBosSteps(-marketDirection, marketChochValue, marketChochBar, marketPendingBos.breakBar + 1, marketChochStepBars, marketChochStepValues)
        marketBosValue := priorBosValue
        marketBosBar := priorBosBar
        marketBosBreakBar := priorBosBreak
        marketBosIdm := priorBosIdm
        marketBosIdmBar := priorBosIdmBar
        marketBosIdmSweepBar := priorBosSweep
        marketBosTriggerValue := na
        array.clear(marketBosStepBars)
        array.clear(marketBosStepValues)
        if not na(priorBosBar)
            marketBosTriggerValue := f_marketBuildBosSteps(marketDirection, priorBosValue, priorBosSweep, priorBosBreak, marketBosStepBars, marketBosStepValues)

        // Стартуем с кандидата на свече BOS и хронологически подтверждаем его
        // собственный IDM. Абсолютный MAX/MIN не получает исключения из правила.
        [seedValue, seedBar, seedIdm, seedIdmBar, seedSweep] = f_marketFindNextKey(marketDirection, marketPendingBos.breakBar, marketPendingBos.breakBar)
        marketExtremeValue := seedValue
        marketExtremeTriggerValue := seedValue
        marketExtremeBar := seedBar
        marketExtremeIdm := seedIdm
        marketExtremeIdmBar := seedIdmBar
        marketExtremeIdmSweepBar := seedSweep
        pendingOppositePivot := seedIdm
        pendingOppositePivotBar := seedIdmBar
        marketHasExtreme := false
        marketChochPending := true
        marketReady := true
        marketStatusText := marketDirection == 1 ? "Ожидается новый ключевой MAX" : "Ожидается новый ключевой MIN"
        replayBar := marketPendingBos.breakBar + 1

        string actualStart = useHighSide ? "MAX" : "MIN"
        string preferredStart = initializeFromHigh ? "MAX" : "MIN"
        marketStartText := "График: MAX " + str.tostring(chartMaximum, format.mintick) + " | MIN " + str.tostring(chartMinimum, format.mintick) + " | старт " + preferredStart + (actualStart == preferredStart ? "" : " → " + actualStart)
    else
        marketRangeOnly := true
        marketStatusText := "Структура пока не определена: диапазон минимума — максимума"
        marketStartText := "График: MAX " + str.tostring(chartMaximum, format.mintick) + " | MIN " + str.tostring(chartMinimum, format.mintick) + " | нет предыдущих ключевых экстремумов"

    // Последовательно воспроизводим торговые диапазоны до текущей свечи.
    int replaySafety = 0
    while marketReady and replayBar <= historyEndBar and replaySafety <= historyEndBar + 1
        float replayHigh = array.get(marketBarHigh, replayBar)
        float replayLow = array.get(marketBarLow, replayBar)
        float replayClose = array.get(marketBarClose, replayBar)
        bool replayBodyConfirmed = replayBar <= bodyEndBar
        // Ожидание ключевого экстремума не приостанавливает проверку CHOCH.
        // Порядок кандидата сохранён: новый экстремум, затем снятие его IDM.
        if not marketHasExtreme
            float oppositePivot = marketDirection == 1 ? array.get(marketPivotLow, replayBar) : array.get(marketPivotHigh, replayBar)
            float candidatePrice = marketDirection == 1 ? replayHigh : replayLow
            // Пивот на самой свече нового экстремума не может быть его IDM.
            bool replacesCandidate = not na(pendingOppositePivot) and not na(pendingOppositePivotBar) and pendingOppositePivotBar < replayBar and (na(marketExtremeValue) or (marketDirection == 1 ? candidatePrice > marketExtremeValue : candidatePrice < marketExtremeValue))
            if replacesCandidate
                marketExtremeValue := candidatePrice
                marketExtremeTriggerValue := candidatePrice
                marketExtremeBar := replayBar
                marketExtremeIdm := pendingOppositePivot
                marketExtremeIdmBar := pendingOppositePivotBar
                marketExtremeIdmSweepBar := na
            bool removesCandidateIdm = not na(marketExtremeValue) and not na(marketExtremeIdm) and replayBar > marketExtremeBar and (marketDirection == 1 ? replayLow < marketExtremeIdm : replayHigh > marketExtremeIdm)
            if removesCandidateIdm
                marketExtremeIdmSweepBar := replayBar
                marketHasExtreme := true
            // Для будущих экстремумов текущий противоположный пивот уже допустим.
            if not na(oppositePivot)
                pendingOppositePivot := oppositePivot
                pendingOppositePivotBar := replayBar

        // После разворота прежний кандидат может стать CHOCH с ещё не снятым
        // IDM. Отслеживаем его снятие и во время ожидания следующего MAX/MIN.
        if na(marketChochIdmSweepBar) and not na(marketChochIdm) and replayBar > marketChochBar
            bool removesChochIdm = marketDirection == 1 ? replayHigh > marketChochIdm : replayLow < marketChochIdm
            if removesChochIdm
                marketChochIdmSweepBar := replayBar

        // До замены прежний CHOCH продолжает действовать. Его подтверждённый
        // пробой имеет приоритет над переносом на только что подтверждённый MAX/MIN.
        bool priorChochBroken = replayBodyConfirmed and not na(marketChochTriggerValue) and not na(marketChochIdmSweepBar) and marketChochIdmSweepBar < replayBar and (marketDirection == 1 ? replayClose < marketChochTriggerValue : replayClose > marketChochTriggerValue)
        if marketChochPending and marketHasExtreme and not priorChochBroken
            int nextBosBar = na(marketPendingBos) ? marketBosBar : marketPendingBos.pointBar
            [nextChoch, nextChochBar, nextChochIdm, nextChochIdmBar, nextChochSweep] = f_marketChochForKey(nextBosBar, marketExtremeBar, marketDirection, replayBar)
            // Следующий экстремум стал ключевым: BOS и CHOCH фиксируются вместе.
            // Метка BOS остаётся на исходной свече пробоя, а не на свече снятия IDM.
            if not na(marketPendingBos)
                marketBosValue := marketPendingBos.value
                marketBosTriggerValue := marketPendingBos.triggerValue
                marketBosBar := marketPendingBos.pointBar
                marketBosBreakBar := marketPendingBos.breakBar
                marketBosIdm := marketPendingBos.idm
                marketBosIdmBar := marketPendingBos.idmBar
                marketBosIdmSweepBar := marketPendingBos.idmSweepBar
                f_marketCopySteps(marketPendingBos.stepBars, marketPendingBos.stepValues, marketBosStepBars, marketBosStepValues)
                marketPendingBos := na
            // Тот же экстремум отката сохраняет уже нарисованные ступени.
            if na(marketChochBar) or nextChochBar != marketChochBar or nextChoch != marketChochValue
                marketChochValue := nextChoch
                marketChochTriggerValue := nextChoch
                marketChochBar := nextChochBar
                marketChochIdm := nextChochIdm
                marketChochIdmBar := nextChochIdmBar
                marketChochIdmSweepBar := nextChochSweep
                array.clear(marketChochStepBars)
                array.clear(marketChochStepValues)
            marketChochPending := false

        // BOS нового кандидата возможен только после свечи снятия его IDM.
        bool canBreakExtreme = marketHasExtreme and (na(marketExtremeIdmSweepBar) or marketExtremeIdmSweepBar < replayBar)

        if marketDirection == 1
            if canBreakExtreme and replayBodyConfirmed and replayClose > marketExtremeTriggerValue
                // Пробой MAX сохраняется кандидатом BOS до снятия IDM следующего
                // максимума. Подтверждённые BOS и CHOCH пока остаются прежними.
                marketPendingBos := MarketBosState.new(marketExtremeValue, marketExtremeTriggerValue, marketExtremeBar, replayBar, marketExtremeIdm, marketExtremeIdmBar, marketExtremeIdmSweepBar, array.copy(marketExtremeStepBars), array.copy(marketExtremeStepValues))
                marketChochPending := true

                // Инициализируем кандидата только на свече пробоя.
                // Последующие свечи обработает основной цикл с проверкой CHOCH.
                [seedValue, seedBar, seedIdm, seedIdmBar, seedSweep] = f_marketFindNextKey(1, replayBar, replayBar)
                marketExtremeValue := seedValue
                marketExtremeTriggerValue := seedValue
                marketExtremeBar := seedBar
                marketExtremeIdm := seedIdm
                marketExtremeIdmBar := seedIdmBar
                marketExtremeIdmSweepBar := seedSweep
                pendingOppositePivot := seedIdm
                pendingOppositePivotBar := seedIdmBar
                array.clear(marketExtremeStepBars)
                array.clear(marketExtremeStepValues)
                marketHasExtreme := false
                marketStatusText := "Ожидается новый ключевой MAX"

            else if replayBodyConfirmed and not na(marketChochTriggerValue) and replayClose < marketChochTriggerValue and not na(marketChochIdmSweepBar) and marketChochIdmSweepBar < replayBar
                // Смена направления: CHOCH становится BOS, MAX становится
                // верхним CHOCH, затем ожидается ключевой MIN.
                // Неподтверждённый кандидат не становится противоположным CHOCH.
                // Последний ключевой MAX — пробитый уровень кандидата BOS,
                // если он есть; его следующий максимум ещё не подтверждён.
                if not marketHasExtreme
                    marketExtremeValue := na(marketPendingBos) ? marketBosValue : marketPendingBos.value
                    marketExtremeTriggerValue := na(marketPendingBos) ? marketBosTriggerValue : marketPendingBos.triggerValue
                    marketExtremeBar := na(marketPendingBos) ? marketBosBar : marketPendingBos.pointBar
                    marketExtremeIdm := na(marketPendingBos) ? marketBosIdm : marketPendingBos.idm
                    marketExtremeIdmBar := na(marketPendingBos) ? marketBosIdmBar : marketPendingBos.idmBar
                    marketExtremeIdmSweepBar := na(marketPendingBos) ? marketBosIdmSweepBar : marketPendingBos.idmSweepBar
                    f_marketCopySteps(na(marketPendingBos) ? marketBosStepBars : marketPendingBos.stepBars, na(marketPendingBos) ? marketBosStepValues : marketPendingBos.stepValues, marketExtremeStepBars, marketExtremeStepValues)
                marketPendingBos := na
                marketBosValue := marketChochValue
                marketBosTriggerValue := marketChochTriggerValue
                marketBosBar := marketChochBar
                marketBosBreakBar := replayBar
                marketBosIdm := marketChochIdm
                marketBosIdmBar := marketChochIdmBar
                marketBosIdmSweepBar := marketChochIdmSweepBar
                f_marketCopySteps(marketChochStepBars, marketChochStepValues, marketBosStepBars, marketBosStepValues)
                marketChochValue := marketExtremeValue
                marketChochTriggerValue := marketExtremeTriggerValue
                marketChochBar := marketExtremeBar
                marketChochIdm := marketExtremeIdm
                marketChochIdmBar := marketExtremeIdmBar
                marketChochIdmSweepBar := marketExtremeIdmSweepBar
                f_marketCopySteps(marketExtremeStepBars, marketExtremeStepValues, marketChochStepBars, marketChochStepValues)
                marketDirection := -1
                marketChochPending := true

                // Инициализируем кандидата только на свече пробоя.
                // Последующие свечи обработает основной цикл с проверкой CHOCH.
                [seedValue, seedBar, seedIdm, seedIdmBar, seedSweep] = f_marketFindNextKey(-1, replayBar, replayBar)
                marketExtremeValue := seedValue
                marketExtremeTriggerValue := seedValue
                marketExtremeBar := seedBar
                marketExtremeIdm := seedIdm
                marketExtremeIdmBar := seedIdmBar
                marketExtremeIdmSweepBar := seedSweep
                pendingOppositePivot := seedIdm
                pendingOppositePivotBar := seedIdmBar
                array.clear(marketExtremeStepBars)
                array.clear(marketExtremeStepValues)
                marketHasExtreme := false
                marketStatusText := "Ожидается новый ключевой MIN"

            else
                if marketHasExtreme and replayHigh > marketExtremeTriggerValue
                    marketExtremeTriggerValue := replayHigh
                    array.push(marketExtremeStepBars, replayBar)
                    array.push(marketExtremeStepValues, marketExtremeTriggerValue)
                if not na(marketChochTriggerValue) and replayLow < marketChochTriggerValue
                    marketChochTriggerValue := replayLow
                    array.push(marketChochStepBars, replayBar)
                    array.push(marketChochStepValues, marketChochTriggerValue)

        else
            if canBreakExtreme and replayBodyConfirmed and replayClose < marketExtremeTriggerValue
                // Зеркальный кандидат BOS после пробоя ключевого MIN.
                marketPendingBos := MarketBosState.new(marketExtremeValue, marketExtremeTriggerValue, marketExtremeBar, replayBar, marketExtremeIdm, marketExtremeIdmBar, marketExtremeIdmSweepBar, array.copy(marketExtremeStepBars), array.copy(marketExtremeStepValues))
                marketChochPending := true

                // Инициализируем кандидата только на свече пробоя.
                // Последующие свечи обработает основной цикл с проверкой CHOCH.
                [seedValue, seedBar, seedIdm, seedIdmBar, seedSweep] = f_marketFindNextKey(-1, replayBar, replayBar)
                marketExtremeValue := seedValue
                marketExtremeTriggerValue := seedValue
                marketExtremeBar := seedBar
                marketExtremeIdm := seedIdm
                marketExtremeIdmBar := seedIdmBar
                marketExtremeIdmSweepBar := seedSweep
                pendingOppositePivot := seedIdm
                pendingOppositePivotBar := seedIdmBar
                array.clear(marketExtremeStepBars)
                array.clear(marketExtremeStepValues)
                marketHasExtreme := false
                marketStatusText := "Ожидается новый ключевой MIN"

            else if replayBodyConfirmed and not na(marketChochTriggerValue) and replayClose > marketChochTriggerValue and not na(marketChochIdmSweepBar) and marketChochIdmSweepBar < replayBar
                // Зеркальная смена направления вверх.
                if not marketHasExtreme
                    marketExtremeValue := na(marketPendingBos) ? marketBosValue : marketPendingBos.value
                    marketExtremeTriggerValue := na(marketPendingBos) ? marketBosTriggerValue : marketPendingBos.triggerValue
                    marketExtremeBar := na(marketPendingBos) ? marketBosBar : marketPendingBos.pointBar
                    marketExtremeIdm := na(marketPendingBos) ? marketBosIdm : marketPendingBos.idm
                    marketExtremeIdmBar := na(marketPendingBos) ? marketBosIdmBar : marketPendingBos.idmBar
                    marketExtremeIdmSweepBar := na(marketPendingBos) ? marketBosIdmSweepBar : marketPendingBos.idmSweepBar
                    f_marketCopySteps(na(marketPendingBos) ? marketBosStepBars : marketPendingBos.stepBars, na(marketPendingBos) ? marketBosStepValues : marketPendingBos.stepValues, marketExtremeStepBars, marketExtremeStepValues)
                marketPendingBos := na
                marketBosValue := marketChochValue
                marketBosTriggerValue := marketChochTriggerValue
                marketBosBar := marketChochBar
                marketBosBreakBar := replayBar
                marketBosIdm := marketChochIdm
                marketBosIdmBar := marketChochIdmBar
                marketBosIdmSweepBar := marketChochIdmSweepBar
                f_marketCopySteps(marketChochStepBars, marketChochStepValues, marketBosStepBars, marketBosStepValues)
                marketChochValue := marketExtremeValue
                marketChochTriggerValue := marketExtremeTriggerValue
                marketChochBar := marketExtremeBar
                marketChochIdm := marketExtremeIdm
                marketChochIdmBar := marketExtremeIdmBar
                marketChochIdmSweepBar := marketExtremeIdmSweepBar
                f_marketCopySteps(marketExtremeStepBars, marketExtremeStepValues, marketChochStepBars, marketChochStepValues)
                marketDirection := 1
                marketChochPending := true

                // Инициализируем кандидата только на свече пробоя.
                // Последующие свечи обработает основной цикл с проверкой CHOCH.
                [seedValue, seedBar, seedIdm, seedIdmBar, seedSweep] = f_marketFindNextKey(1, replayBar, replayBar)
                marketExtremeValue := seedValue
                marketExtremeTriggerValue := seedValue
                marketExtremeBar := seedBar
                marketExtremeIdm := seedIdm
                marketExtremeIdmBar := seedIdmBar
                marketExtremeIdmSweepBar := seedSweep
                pendingOppositePivot := seedIdm
                pendingOppositePivotBar := seedIdmBar
                array.clear(marketExtremeStepBars)
                array.clear(marketExtremeStepValues)
                marketHasExtreme := false
                marketStatusText := "Ожидается новый ключевой MAX"

            else
                if marketHasExtreme and replayLow < marketExtremeTriggerValue
                    marketExtremeTriggerValue := replayLow
                    array.push(marketExtremeStepBars, replayBar)
                    array.push(marketExtremeStepValues, marketExtremeTriggerValue)
                if not na(marketChochTriggerValue) and replayHigh > marketChochTriggerValue
                    marketChochTriggerValue := replayHigh
                    array.push(marketChochStepBars, replayBar)
                    array.push(marketChochStepValues, marketChochTriggerValue)

        replayBar += 1
        replaySafety += 1

// Предварительное состояние обновляем отдельно от полного прохода по истории.
// На закрытии используется заново рассчитанный подтверждённый результат.
if enableMarketStructure and (marketNeedsReplay or barstate.islast)
    // Незакрытая последняя свеча не подтверждает BOS/CHOCH телом. Однако её
    // тень сразу снимает IDM кандидата и обновляет отображаемый MAX/MIN.
    bool hasLiveBar = not barstate.isconfirmed and not na(marketReplayEndBar) and bar_index > marketReplayEndBar

    // Как в f_marketFindNextKey(): сначала обновляем кандидата MAX/MIN,
    // затем проверяем снятие IDM. Новая вершина не подтверждается своей свечой.
    if marketReady and hasLiveBar and not na(marketExtremeValue)
        if marketDirection == 1 and high > marketExtremeTriggerValue
            if marketHasExtreme
                marketExtremeTriggerValue := high
                array.push(marketExtremeStepBars, bar_index)
                array.push(marketExtremeStepValues, marketExtremeTriggerValue)
            else
                marketExtremeValue := high
                marketExtremeTriggerValue := high
                marketExtremeBar := bar_index
                marketExtremeIdm := pendingOppositePivot
                marketExtremeIdmBar := pendingOppositePivotBar
                array.clear(marketExtremeStepBars)
                array.clear(marketExtremeStepValues)
        else if marketDirection == -1 and low < marketExtremeTriggerValue
            if marketHasExtreme
                marketExtremeTriggerValue := low
                array.push(marketExtremeStepBars, bar_index)
                array.push(marketExtremeStepValues, marketExtremeTriggerValue)
            else
                marketExtremeValue := low
                marketExtremeTriggerValue := low
                marketExtremeBar := bar_index
                marketExtremeIdm := pendingOppositePivot
                marketExtremeIdmBar := pendingOppositePivotBar
                array.clear(marketExtremeStepBars)
                array.clear(marketExtremeStepValues)

    // Достаточно тени последующей свечи; закрытия для предварительного снятия
    // IDM не ждём. После обновления кандидата marketExtremeBar == bar_index,
    // поэтому одновременный выход за экстремум и IDM не подтверждает кандидата.
    bool liveRemovesExtremeIdm = marketReady and hasLiveBar and not marketHasExtreme and not na(marketExtremeValue) and not na(marketExtremeIdm) and bar_index > marketExtremeBar and (marketDirection == 1 ? low < marketExtremeIdm : high > marketExtremeIdm)
    if liveRemovesExtremeIdm
        marketExtremeIdmSweepBar := bar_index
        marketHasExtreme := true
        // Предварительный перенос откатывается вместе с текущим тиком.
        // Закрытие заново воспроизведёт правило и проверит возможный пробой.
        if marketChochPending
            int liveBosBar = na(marketPendingBos) ? marketBosBar : marketPendingBos.pointBar
            [liveChoch, liveChochBar, liveChochIdm, liveChochIdmBar, liveChochSweep] = f_marketChochForKey(liveBosBar, marketExtremeBar, marketDirection, bar_index)
            if not na(marketPendingBos)
                marketBosValue := marketPendingBos.value
                marketBosTriggerValue := marketPendingBos.triggerValue
                marketBosBar := marketPendingBos.pointBar
                marketBosBreakBar := marketPendingBos.breakBar
                marketBosIdm := marketPendingBos.idm
                marketBosIdmBar := marketPendingBos.idmBar
                marketBosIdmSweepBar := marketPendingBos.idmSweepBar
                f_marketCopySteps(marketPendingBos.stepBars, marketPendingBos.stepValues, marketBosStepBars, marketBosStepValues)
                marketPendingBos := na
            if na(marketChochBar) or liveChochBar != marketChochBar or liveChoch != marketChochValue
                marketChochValue := liveChoch
                marketChochTriggerValue := liveChoch
                marketChochBar := liveChochBar
                marketChochIdm := liveChochIdm
                marketChochIdmBar := liveChochIdmBar
                marketChochIdmSweepBar := liveChochSweep
                array.clear(marketChochStepBars)
                array.clear(marketChochStepValues)
            marketChochPending := false

    if marketReady and marketHasExtreme
        marketStatusText := marketDirection == 1 ? "Восходящий диапазон: CHOCH — MAX" : "Нисходящий диапазон: CHOCH — MIN"

//------------------------------------------------------------------------------
// Отображение только актуального комплекта уровней.
//------------------------------------------------------------------------------

var array<line> marketLevelLines = array.new_line()
var array<polyline> marketLevelPolylines = array.new<polyline>()
var array<label> marketLevelLabels = array.new_label()
var table marketStatusTable = table.new(position.bottom_right, 1, 2)

if barstate.islast
    while array.size(marketLevelLines) > 0
        line.delete(array.pop(marketLevelLines))
    while array.size(marketLevelPolylines) > 0
        polyline.delete(array.pop(marketLevelPolylines))
    while array.size(marketLevelLabels) > 0
        label.delete(array.pop(marketLevelLabels))
    int rightTime = na(time_close) ? time : time_close

    if enableMarketStructure and marketRangeOnly and not na(marketChartMaximum) and not na(marketChartMinimum)
        line rawMaximumLine = line.new(f_marketTime(marketChartMaximumBar), marketChartMaximum, rightTime, marketChartMaximum, xloc = xloc.bar_time, extend = extend.none, color = marketMaxColor, width = marketMaxWidth, style = line.style_solid)
        line rawMinimumLine = line.new(f_marketTime(marketChartMinimumBar), marketChartMinimum, rightTime, marketChartMinimum, xloc = xloc.bar_time, extend = extend.none, color = marketMinColor, width = marketMinWidth, style = line.style_solid)
        label rawMaximumLabel = label.new(rightTime, marketChartMaximum, "Максимум графика", xloc = xloc.bar_time, style = label.style_label_left, color = marketMaxColor, textcolor = color.white, size = size.small)
        label rawMinimumLabel = label.new(rightTime, marketChartMinimum, "Минимум графика", xloc = xloc.bar_time, style = label.style_label_left, color = marketMinColor, textcolor = color.white, size = size.small)
        array.push(marketLevelLines, rawMaximumLine)
        array.push(marketLevelLines, rawMinimumLine)
        array.push(marketLevelLabels, rawMaximumLabel)
        array.push(marketLevelLabels, rawMinimumLabel)

    if enableMarketStructure and marketReady
        if not na(marketBosValue)
            int bosEndTime = f_marketTime(marketBosBreakBar)
            f_marketStepPolyline(marketLevelPolylines, marketBosBar, marketBosValue, marketBosStepBars, marketBosStepValues, bosEndTime, marketBosColor, marketBosWidth)
            label bosLabel = label.new(bosEndTime, marketBosTriggerValue, "BOS", xloc = xloc.bar_time, style = label.style_label_left, color = marketBosColor, textcolor = color.white, size = size.small)
            array.push(marketLevelLabels, bosLabel)

        if not na(marketChochValue)
            f_marketStepPolyline(marketLevelPolylines, marketChochBar, marketChochValue, marketChochStepBars, marketChochStepValues, rightTime, marketChochColor, marketChochWidth)
            label chochLabel = label.new(rightTime, marketChochTriggerValue, "CHOCH", xloc = xloc.bar_time, style = label.style_label_left, color = marketChochColor, textcolor = color.white, size = size.small)
            array.push(marketLevelLabels, chochLabel)

        // Кандидат MAX/MIN показывается сразу после BOS, ещё до снятия его IDM.
        if not na(marketExtremeValue) and not na(marketExtremeBar)
            string extremeText = marketDirection == 1 ? "MAX" : "MIN"
            color extremeColor = marketDirection == 1 ? marketMaxColor : marketMinColor
            int extremeWidth = marketDirection == 1 ? marketMaxWidth : marketMinWidth
            f_marketStepPolyline(marketLevelPolylines, marketExtremeBar, marketExtremeValue, marketExtremeStepBars, marketExtremeStepValues, rightTime, extremeColor, extremeWidth)
            label extremeLabel = label.new(rightTime, marketExtremeTriggerValue, extremeText, xloc = xloc.bar_time, style = label.style_label_left, color = extremeColor, textcolor = color.white, size = size.small)
            array.push(marketLevelLabels, extremeLabel)

        if showMarketIdm
            if not na(marketBosIdm)
                int bosIdmEndTime = na(marketBosIdmSweepBar) ? rightTime : f_marketTime(marketBosIdmSweepBar)
                line bosIdmLine = line.new(f_marketTime(marketBosIdmBar), marketBosIdm, bosIdmEndTime, marketBosIdm, xloc = xloc.bar_time, extend = extend.none, color = marketIdmColor, width = marketIdmWidth, style = line.style_dashed)
                label bosIdmLabel = label.new(bosIdmEndTime, marketBosIdm, "IDM BOS", xloc = xloc.bar_time, style = label.style_label_left, color = marketIdmColor, textcolor = color.white, size = size.tiny)
                array.push(marketLevelLines, bosIdmLine)
                array.push(marketLevelLabels, bosIdmLabel)

            if not na(marketChochIdm)
                int chochIdmEndTime = na(marketChochIdmSweepBar) ? rightTime : f_marketTime(marketChochIdmSweepBar)
                line chochIdmLine = line.new(f_marketTime(marketChochIdmBar), marketChochIdm, chochIdmEndTime, marketChochIdm, xloc = xloc.bar_time, extend = extend.none, color = marketIdmColor, width = marketIdmWidth, style = line.style_dashed)
                label chochIdmLabel = label.new(chochIdmEndTime, marketChochIdm, "IDM CHOCH", xloc = xloc.bar_time, style = label.style_label_left, color = marketIdmColor, textcolor = color.white, size = size.tiny)
                array.push(marketLevelLines, chochIdmLine)
                array.push(marketLevelLabels, chochIdmLabel)

            if not na(marketExtremeIdm) and not na(marketExtremeIdmBar)
                int extremeIdmEndTime = na(marketExtremeIdmSweepBar) ? rightTime : f_marketTime(marketExtremeIdmSweepBar)
                string extremeIdmText = marketDirection == 1 ? "IDM MAX" : "IDM MIN"
                line extremeIdmLine = line.new(f_marketTime(marketExtremeIdmBar), marketExtremeIdm, extremeIdmEndTime, marketExtremeIdm, xloc = xloc.bar_time, extend = extend.none, color = marketIdmColor, width = marketIdmWidth, style = line.style_dashed)
                label extremeIdmLabel = label.new(extremeIdmEndTime, marketExtremeIdm, extremeIdmText, xloc = xloc.bar_time, style = label.style_label_left, color = marketIdmColor, textcolor = color.white, size = size.tiny)
                array.push(marketLevelLines, extremeIdmLine)
                array.push(marketLevelLabels, extremeIdmLabel)

    if marketHistoryLimitReached
        table.cell(marketStatusTable, 0, 0, "BOS/CHOCH/MAX/MIN отключены: история превышает 100 000 свечей", bgcolor = color.new(color.orange, 15), text_color = color.white, text_size = size.small)
        table.cell(marketStatusTable, 0, 1, "Уменьшите загруженную историю. Ломаная продолжает работать.", bgcolor = color.new(color.black, 35), text_color = color.white, text_size = size.tiny)
    else if showMarketStatus
        color statusColor = marketReady ? color.new(marketDirection == 1 ? marketMaxColor : marketMinColor, 15) : color.new(color.orange, 15)
        table.cell(marketStatusTable, 0, 0, marketStatusText, bgcolor = statusColor, text_color = color.white, text_size = size.small)
        table.cell(marketStatusTable, 0, 1, marketStartText, bgcolor = color.new(color.black, 35), text_color = color.white, text_size = size.tiny)
    else
        table.cell(marketStatusTable, 0, 0, "", bgcolor = color.new(color.black, 100), text_color = color.new(color.white, 100))
        table.cell(marketStatusTable, 0, 1, "", bgcolor = color.new(color.black, 100), text_color = color.new(color.white, 100))

// Отдельные невидимые серии выводят на ценовую шкалу только актуальные
// структурные уровни. Сами линии по-прежнему рисуются объектами выше.
plot(enableMarketStructure and marketReady and not na(marketChochValue) ? marketChochTriggerValue : na, "CHOCH", color = marketChochColor, display = display.price_scale, show_last = 1)
plot(enableMarketStructure and marketReady and marketDirection == 1 and not na(marketExtremeValue) ? marketExtremeTriggerValue : na, "MAX", color = marketMaxColor, display = display.price_scale, show_last = 1)
plot(enableMarketStructure and marketReady and marketDirection == -1 and not na(marketExtremeValue) ? marketExtremeTriggerValue : na, "MIN", color = marketMinColor, display = display.price_scale, show_last = 1)

//------------------------------------------------------------------------------
//------------------------------------------------------------------------------

// Внутренние и материнские свечи
// Adapted from Inside Bars (Multiple / Consecutive).
// This source code is subject to the terms of the Mozilla Public License 2.0 at
// https://mozilla.org/MPL/2.0/
// © nilstrades_
// Изменения: интеграция, префиксы имён, русские подписи и выключатель блока.
// Треугольники, границы, заливка и ценовые метки диапазона удалены.
// Пустые тела внутренних свечей, включая последнюю. Отдельная линия цены не создаётся.
// Прозрачная окраска может влиять на стандартную линию цены при автоматическом цвете.
// Изменение v1.53: весь High/Low внутренней свечи должен оставаться внутри
// неизменного диапазона материнской. Выход любой тени завершает цепочку.
// Здесь «материнская» — свеча-контейнер серии внутренних свечей, а не
// структурная материнская свеча из блока ломаной.
//------------------------------------------------------------------------------

bool ibEnabled = input.bool(true, "Пустые внутренние свечи", tooltip = "Убирает заливку тела, включая последнюю внутреннюю свечу. Если стандартная линия цены становится невидимой, задайте ей непрозрачный цвет в настройках графика TradingView.", group = GROUP_VIEW)

var float ibMotherHigh = na
var float ibMotherLow = na
var bool ibConsecutive = false

bool ibIsInsideBar = high <= high[1] and low >= low[1]
bool ibReset = false

if ibEnabled
    if ibIsInsideBar and not ibConsecutive
        ibMotherHigh := high[1]
        ibMotherLow := low[1]
        ibConsecutive := true

    if ibConsecutive
        // Касание границы допустимо; выход за неё даже одной тенью — нет.
        if high > ibMotherHigh or low < ibMotherLow
            ibReset := true

if ibReset or not ibEnabled
    ibMotherHigh := na
    ibMotherLow := na
    ibConsecutive := false

// Не исключаем текущую свечу и не ждём её закрытия для удаления заливки.
barcolor(ibEnabled and ibConsecutive ? color.new(color.black, 100) : na, title = "Пустые внутренние свечи")

//------------------------------------------------------------------------------
// Последний поток приказов: настройки отображения.
//------------------------------------------------------------------------------
// Собственный поток рассчитывается только на H1 / H4 / D / W / M.
// Вложенный вызов на H1 использует свой ТФ даже на графике M1/M5.
f_isFlowTimeframe() =>
    float seconds = timeframe.in_seconds()
    seconds == 3600 or seconds == 14400 or (timeframe.isdaily and timeframe.multiplier == 1) or (timeframe.isweekly and timeframe.multiplier == 1) or (timeframe.ismonthly and timeframe.multiplier == 1)

bool flowOnChart = f_isFlowTimeframe()
bool flowShowLevels = input.bool(true, "Уровни последнего потока", group = "Последний поток приказов", tooltip = "На H1/H4/D/W/M — собственные уровни. На M1/M5 переносятся уровни потока H1, если включён перенос ниже. Фильтр FVG действует и при скрытых уровнях. 0 — минимум, 1 — максимум; начало потока задаёт пробившее плечо.")
bool flowH1OnM5 = input.bool(true, "Показывать поток H1 на M1 / M5", group = "Последний поток приказов", tooltip = "Те же уровни 0 / 0,4 / 0,5 / 0,6 / 1, рассчитанные по H1. На открытой H1-свече диапазон может изменяться.")
bool flowShowPrevious = input.bool(true, "Показывать предыдущий поток", group = "Последний поток приказов", tooltip = "Пунктирные уровни предыдущего потока от его начала до свечи подтверждения смены. На M1/M5 — предыдущий поток H1.")
bool flowShowData = input.bool(false, "Отображать данные действующего потока", group = "Последний поток приказов", tooltip = "Показывать значения уровней и цены действующего потока, включая H1 на M1/M5. Предыдущий поток всегда без подписей.")
bool flowDiagnosticEnabled = input.bool(false, "Диагностика смены потока", group = "Последний поток приказов")
string flowDiagnosticFont = input.string(size.large, "Размер шрифта диагностики", options = [size.small, size.normal, size.large, size.huge], group = "Последний поток приказов")
float flowDiagnosticBottomOffset = input.float(6.0, "Отступ диагностики снизу (%)", minval = 0, maxval = 40, step = 1, group = "Последний поток приказов")
color flowPreviousColor = input.color(color.new(#000000, 80), "Цвет предыдущего потока", group = "Последний поток приказов")
color flowColor0 = input.color(#388E3C, "Цвет уровня 0", group = "Последний поток приказов")
color flowColor04 = input.color(#388E3C, "Цвет уровня 0,4", group = "Последний поток приказов")
color flowColor05 = input.color(#636363, "Цвет уровня 0,5", group = "Последний поток приказов")
color flowColor06 = input.color(#B22833, "Цвет уровня 0,6", group = "Последний поток приказов")
color flowColor1 = input.color(#B22833, "Цвет уровня 1", group = "Последний поток приказов")
int flowLineWidth = input.int(3, "Толщина линий", minval = 1, maxval = 5, group = "Последний поток приказов")
string flowFontSize = input.string(size.normal, "Размер шрифта", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = "Последний поток приказов")

//------------------------------------------------------------------------------
// FVG — расчёт на исходных таймфреймах и общий вывод зон.
string FVG_GROUP = "FVG"
bool fvgEnabled = input.bool(true, "Показывать FVG", group = FVG_GROUP)
bool fvgShowM1 = input.bool(true, "Показывать FVG M1", group = FVG_GROUP, tooltip = "На M1 показываются зоны, пересекающие отображаемый рабочий FVG H1/H4/D/W/M и начинающиеся не раньше него. Достаточно частичного пересечения по цене. Это правило действует и для пробитых зон: они сохраняют цвет пробоя и заканчиваются на свече пробоя. На FVG старших таймфреймов не влияет.")
bool fvgShowM5 = input.bool(true, "Показывать FVG M5", group = FVG_GROUP, tooltip = "На M5 показываются зоны, пересекающие отображаемый рабочий FVG H1/H4/D/W/M и начинающиеся не раньше него. Достаточно частичного пересечения по цене. Это правило действует и для пробитых зон: они сохраняют цвет пробоя и заканчиваются на свече пробоя. На FVG старших таймфреймов не влияет.")
bool fvgExcludeGaps = input.bool(true, "Исключать FVG с гэпами", group = FVG_GROUP, tooltip = "Не создавать FVG, если диапазоны по теням любой пары соседних свечей в тройке не пересекаются. Касание границ допускается. Проверка на исходном таймфрейме зоны; разница открытия и предыдущего закрытия сама по себе не считается гэпом.")
bool fvgMtfDiagnostics = input.bool(false, "Диагностика FVG H1 / M1 / M5", tooltip = "На M1/M5 показывает доступность снимка H1, число зон H1, отображаемых рабочих старших зон и показанных FVG.", group = FVG_GROUP)
bool fvgOnlyInFlow = input.bool(true, "FVG текущего и предыдущего потоков", tooltip = "На родном ТФ показываем зоны текущего и предыдущего потоков. На младшие ТФ переносим только один рабочий FVG каждого старшего ТФ. После пробоя ждём новый FVG ближе к конечному экстремуму потока.", group = FVG_GROUP)
int fvgMaxZones = input.int(20, "Хранить последних зон", minval = 1, maxval = 200, tooltip = "Лимит отображаемых зон суммарно: на M1/M5 сначала H1/H4/D/W/M, затем зоны своего ТФ. На каждом исходном таймфрейме хранится до этого количества последних зон.", group = FVG_GROUP)
color fvgFilledColor = input.color(color.new(#F57F17, 85), "Цвет пробитого FVG", group = FVG_GROUP)
color fvgBullColor = input.color(color.new(#00332A, 85), "Бычий FVG", group = FVG_GROUP)
color fvgBearColor = input.color(color.new(#801922, 85), "Медвежий FVG", group = FVG_GROUP)

int fvgBorderWidth = input.int(1, "Толщина границ FVG", minval = 1, maxval = 5, group = FVG_GROUP)
string fvgFontM1 = input.string(size.tiny, "Шрифт FVG M1", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = FVG_GROUP)
string fvgFontM5 = input.string(size.tiny, "Шрифт FVG M5", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = FVG_GROUP)
string fvgFontH1 = input.string(size.small, "Шрифт FVG H1", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = FVG_GROUP)
string fvgFontH4 = input.string(size.normal, "Шрифт FVG H4", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = FVG_GROUP)
string fvgFontD = input.string(size.normal, "Шрифт FVG D", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = FVG_GROUP)
string fvgFontW = input.string(size.large, "Шрифт FVG W", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = FVG_GROUP)
string fvgFontM = input.string(size.huge, "Шрифт FVG M", options = [size.tiny, size.small, size.normal, size.large, size.huge], group = FVG_GROUP)
int fvgMiddleWidth = input.int(1, "Толщина точечной середины", minval = 1, maxval = 5, group = FVG_GROUP)

f_mtfFlow() =>
    var int direction = 0
    var int outsideOrigin = 0
    var int outsideBasePivotTime = na
    var int outsideBasePivotBar = na
    var float outsideBasePivotPrice = na
    var float legExtreme = na
    var int legExtremeBar = na
    var int legExtremeTime = na
    var float motherHigh = na
    var float motherLow = na
    var float lastPivotPrice = na
    var int lastPivotBar = na
    var int lastPivotTime = na
    var float initialHigh = na
    var int initialHighBar = na
    var int initialHighTime = na
    var float initialLow = na
    var int initialLowBar = na
    var int initialLowTime = na
    if barstate.isfirst
        initialHigh := high
        initialHighBar := bar_index
        initialHighTime := time
        initialLow := low
        initialLowBar := bar_index
        initialLowTime := time
    if not barstate.isfirst
        if direction == 0
            bool brokeInitialHigh = high > initialHigh
            bool brokeInitialLow = low < initialLow
            int chosenDirection = 0
            if brokeInitialHigh and not brokeInitialLow
                chosenDirection := 1
            else if brokeInitialLow and not brokeInitialHigh
                chosenDirection := -1
            else if brokeInitialHigh and brokeInitialLow
                float upExpansion = high - initialHigh
                float downExpansion = initialLow - low
                bool assumedLong = upExpansion >= downExpansion
                outsideBasePivotTime := assumedLong ? initialLowTime : initialHighTime
                outsideBasePivotBar := assumedLong ? initialLowBar : initialHighBar
                outsideBasePivotPrice := assumedLong ? initialLow : initialHigh
                chosenDirection := assumedLong ? -1 : 1
                direction := chosenDirection
                outsideOrigin := assumedLong ? 1 : -1
                lastPivotPrice := assumedLong ? high : low
                lastPivotBar := bar_index
                lastPivotTime := time
                legExtreme := assumedLong ? low : high
                legExtremeBar := bar_index
                legExtremeTime := time
                motherHigh := high
                motherLow := low
            if chosenDirection == 1 and not brokeInitialLow
                direction := 1
                lastPivotPrice := initialLow
                lastPivotBar := initialLowBar
                lastPivotTime := initialLowTime
                legExtreme := high
                legExtremeBar := bar_index
                legExtremeTime := time
                motherHigh := high
                motherLow := low
            else if chosenDirection == -1 and not brokeInitialHigh
                direction := -1
                lastPivotPrice := initialHigh
                lastPivotBar := initialHighBar
                lastPivotTime := initialHighTime
                legExtreme := low
                legExtremeBar := bar_index
                legExtremeTime := time
                motherHigh := high
                motherLow := low
        else
            bool brokeMotherHigh = high > motherHigh
            bool brokeMotherLow = low < motherLow
            if brokeMotherHigh and brokeMotherLow
                bool continuingOutsideChain = outsideOrigin != 0
                int pathDirection = continuingOutsideChain ? outsideOrigin : direction
                if not continuingOutsideChain
                    outsideOrigin := direction
                    outsideBasePivotTime := lastPivotTime
                    outsideBasePivotBar := lastPivotBar
                    outsideBasePivotPrice := lastPivotPrice
                if pathDirection == 1
                    lastPivotPrice := high
                    lastPivotBar := bar_index
                    lastPivotTime := time
                    direction := -1
                    legExtreme := low
                    legExtremeBar := bar_index
                    legExtremeTime := time
                else
                    lastPivotPrice := low
                    lastPivotBar := bar_index
                    lastPivotTime := time
                    direction := 1
                    legExtreme := high
                    legExtremeBar := bar_index
                    legExtremeTime := time
                motherHigh := high
                motherLow := low
            else if direction == 1
                if brokeMotherLow
                    float turnPrice = legExtreme
                    int turnBar = legExtremeBar
                    int turnTime = legExtremeTime
                    lastPivotPrice := turnPrice
                    lastPivotBar := turnBar
                    lastPivotTime := turnTime
                    direction := -1
                    legExtreme := low
                    legExtremeBar := bar_index
                    legExtremeTime := time
                    motherHigh := high
                    motherLow := low
                    outsideOrigin := 0
                    outsideBasePivotTime := na
                    outsideBasePivotBar := na
                    outsideBasePivotPrice := na
                else if brokeMotherHigh
                    legExtreme := high
                    legExtremeBar := bar_index
                    legExtremeTime := time
                    motherHigh := high
                    motherLow := low
                    outsideOrigin := 0
                    outsideBasePivotTime := na
                    outsideBasePivotBar := na
                    outsideBasePivotPrice := na
            else if direction == -1
                if brokeMotherHigh
                    float turnPrice = legExtreme
                    int turnBar = legExtremeBar
                    int turnTime = legExtremeTime
                    lastPivotPrice := turnPrice
                    lastPivotBar := turnBar
                    lastPivotTime := turnTime
                    direction := 1
                    legExtreme := high
                    legExtremeBar := bar_index
                    legExtremeTime := time
                    motherHigh := high
                    motherLow := low
                    outsideOrigin := 0
                    outsideBasePivotTime := na
                    outsideBasePivotBar := na
                    outsideBasePivotPrice := na
                else if brokeMotherLow
                    legExtreme := low
                    legExtremeBar := bar_index
                    legExtremeTime := time
                    motherHigh := high
                    motherLow := low
                    outsideOrigin := 0
                    outsideBasePivotTime := na
                    outsideBasePivotBar := na
                    outsideBasePivotPrice := na
    [direction, lastPivotTime, lastPivotPrice, legExtreme, outsideOrigin, outsideBasePivotTime, outsideBasePivotPrice, lastPivotBar, legExtremeBar, outsideBasePivotBar, legExtremeTime]

// Фильтр только для потоков: первое и встречное плечо принимаются, если их
// начало и экстремум лежат на разных свечах. Возраст внутренних свечей
// не превращает односвечное внешнее плечо в допустимое.
f_orderMovement(int rawDir, int rawStart, float rawBase, float rawTip, int rawStartBar, int rawTipBar, int rawTipTime) =>
    var int moveDir = 0
    var int moveStart = na
    var float moveBase = na
    var float moveTip = na
    var int moveTipTime = na
    if moveDir == 0 and rawDir != 0
        if not na(rawStartBar) and not na(rawTipBar) and rawTipBar - rawStartBar + 1 >= 2
            moveDir := rawDir
            moveStart := rawStart
            moveBase := rawBase
            moveTip := rawTip
            moveTipTime := rawTipTime
    else if moveDir != 0 and rawDir == moveDir
        // При совпадении направления сохраняем начало принятого движения.
        if moveDir == 1 ? rawTip > moveTip : rawTip < moveTip
            moveTipTime := rawTipTime
        moveTip := moveDir == 1 ? math.max(moveTip, rawTip) : math.min(moveTip, rawTip)
    else if rawDir != 0
        if not na(rawStartBar) and not na(rawTipBar) and rawTipBar - rawStartBar + 1 >= 2
            moveDir := rawDir
            moveStart := rawStart
            moveBase := rawBase
            moveTip := rawTip
            moveTipTime := rawTipTime
    [moveDir, moveStart, moveBase, moveTip, moveTipTime]

// Данные зоны для переноса между ТФ; графические объекты сюда не входят.
type MtfFvg
    int leftTime
    int impulseTime
    float top
    float bottom
    int side
    bool active
    int rightTime

// Отдельный индекс ещё непробитых FVG: полностью сохраняем архив zones,
// но не проверяем пробитые зоны повторно на каждой из тысяч исторических свечей.
// Индексы обновляются при сдвиге ограниченного массива zones.
f_fvgUpdateActive(array<MtfFvg> zones, array<int> activeIndices) =>
    int cursor = array.size(activeIndices) - 1
    while cursor >= 0
        int zoneIndex = array.get(activeIndices, cursor)
        MtfFvg zone = array.get(zones, zoneIndex)
        zone.rightTime := time_close
        if zone.side == 1 ? close <= zone.bottom : close >= zone.top
            zone.active := false
            array.remove(activeIndices, cursor)
        cursor -= 1

f_fvgAppendActive(array<MtfFvg> zones, array<int> activeIndices, MtfFvg zone) =>
    if array.size(zones) >= fvgMaxZones
        array.shift(zones)
        int cursor = array.size(activeIndices) - 1
        while cursor >= 0
            int oldIndex = array.get(activeIndices, cursor)
            if oldIndex == 0
                array.remove(activeIndices, cursor)
            else
                array.set(activeIndices, cursor, oldIndex - 1)
            cursor -= 1
    array.push(zones, zone)
    array.push(activeIndices, array.size(zones) - 1)

// Расчётная зона движения независима от массива отображения.
type FlowFvg
    float top
    float bottom
    int side
    int impulseTime
    bool balanced = false
    int brokenAt = na
    int leftTime = na

f_updateFlowFvg(FlowFvg zone) =>
    if not na(zone) and na(zone.brokenAt)
        float midpoint = (zone.top + zone.bottom) / 2.0
        if zone.side == 1 ? close <= midpoint : close >= midpoint
            zone.balanced := true
        if zone.side == 1 ? close <= zone.bottom : close >= zone.top
            zone.brokenAt := time
    zone

f_pickSavedFlowFvg(FlowFvg currentZone, FlowFvg candidate) =>
    FlowFvg result = currentZone
    bool closer = na(currentZone)
    if not closer
        closer := candidate.side == 1 ? candidate.top > currentZone.top : candidate.bottom < currentZone.bottom
    if closer
        result := candidate
    result

// Неопределённая привязка FVG живёт отдельно от массива отображения.
type PendingFlowFvg
    FlowFvg zone
    int formedAt
    int originTime
    int originBar
    float originPrice
    float rangeLo
    float rangeHi
    bool ready
    int chainKey
    bool outsideFirst
    bool firstAttachment
    int rangeLoTime
    int rangeHiTime

// Встречные зоны хранятся независимо: пробой одной не отменяет остальные.
// Время формирования относится к подтверждающему FVG, а рабочая зона нового
// потока выбирается отдельно среди живых FVG того же движения.
type RuleOneFvg
    FlowFvg zone
    int formedAt
    int originTime
    float lo
    float hi
    int loTime
    int hiTime

f_updateRuleOneFvgs(array<RuleOneFvg> candidates, int direction, int start, int impulse) =>
    int index = 0
    while index < array.size(candidates)
        RuleOneFvg candidate = array.get(candidates, index)
        candidate.zone := f_updateFlowFvg(candidate.zone)
        bool invalid = not na(candidate.zone.brokenAt) or candidate.zone.side != -direction or candidate.originTime < start or na(impulse) or candidate.zone.impulseTime <= impulse
        if invalid
            array.remove(candidates, index)
        else
            if low < candidate.lo
                candidate.lo := low
                candidate.loTime := time
            if high > candidate.hi
                candidate.hi := high
                candidate.hiTime := time
            index += 1
    array.size(candidates)

f_pickRuleOneFvg(array<RuleOneFvg> candidates, bool required, int captureTime) =>
    RuleOneFvg latest = na
    RuleOneFvg eligible = na
    for candidate in candidates
        if na(latest) or candidate.formedAt >= latest.formedAt
            latest := candidate
        bool afterCapture = not required or (not na(captureTime) and candidate.formedAt > captureTime)
        if afterCapture and (na(eligible) or candidate.formedAt >= eligible.formedAt)
            eligible := candidate
    // До захвата факт FVG остаётся виден в диагностике, но не даёт разворот.
    RuleOneFvg result = na(eligible) ? latest : eligible
    result

f_ruleOneWorkingZone(array<RuleOneFvg> candidates, RuleOneFvg selected) =>
    FlowFvg result = na
    if not na(selected)
        for candidate in candidates
            if candidate.originTime == selected.originTime
                result := f_pickSavedFlowFvg(result, candidate.zone)
    result

type MtfSnapshot
    array<MtfFvg> zones
    int direction
    float lo
    float hi
    int startTime
    int closedAt
    int sourceOpen
    int prevStart
    int prevEnd
    float prevLo
    float prevHi
    bool firstBroken
    float firstTop
    float firstBottom
    string diagnostic
    int workingLeftTime
    int workingImpulseTime

f_mtfCopy(array<MtfFvg> zones, int dir, float lo, float hi, int start, int closedAt, int sourceOpen, int prevStart, int prevEnd, float prevLo, float prevHi, bool firstBroken, float firstTop, float firstBottom, int workingLeftTime, int workingImpulseTime, string diagnostic) =>
    array<MtfFvg> copied = array.new<MtfFvg>()
    for zone in zones
        array.push(copied, MtfFvg.new(zone.leftTime, zone.impulseTime, zone.top, zone.bottom, zone.side, zone.active, zone.rightTime))
    MtfSnapshot.new(copied, dir, lo, hi, start, closedAt, sourceOpen, prevStart, prevEnd, prevLo, prevHi, firstBroken, firstTop, firstBottom, diagnostic, workingLeftTime, workingImpulseTime)


int liquidityHistoryBars = input.int(1000, "История старших ТФ для условия №1", minval = 100, maxval = 2000, group = "Последний поток приказов")

// Рабочая пара: максимум + его IDM либо минимум + его IDM.
// Внутренние повороты уточняют только кандидата. Пара меняется по пробою
// её границы; касание не пробой. Кандидат — последний поворот перед пробоем.
f_legIdm(int rawDir, int pivotTime, float pivotPrice, int outsidePath, int outsideStart, float outsideBase) =>
    var int pairDirection = 0
    var float pairHigh = na
    var float pairLow = na
    var int pairHighKey = na
    var int pairLowKey = na
    var float candidateHigh = na
    var float candidateLow = na
    var int candidateHighKey = na
    var int candidateLowKey = na
    var int seenPivot = na
    var int seenDir = 0
    bool currentOutside = outsidePath != 0 and pivotTime == time and not na(outsideBase) and not na(outsideStart)
    bool newPivot = not na(pivotTime) and (na(seenPivot) or pivotTime != seenPivot or rawDir != seenDir)
    if pairDirection == 0 and rawDir != 0 and not na(pivotPrice)
        pairDirection := rawDir
        pairHigh := rawDir == -1 ? pivotPrice : high
        pairLow := rawDir == 1 ? pivotPrice : low
        pairHighKey := rawDir == -1 ? pivotTime : time
        pairLowKey := rawDir == 1 ? pivotTime : time
        candidateHigh := pairHigh
        candidateLow := pairLow
        candidateHighKey := pairHighKey
        candidateLowKey := pairLowKey
    else if pairDirection != 0
        if currentOutside
            // Как в ломаной: первое движение внешней свечи продолжает
            // входящее плечо. Второе проверяется уже против обновлённой пары.
            if outsidePath == 1
                if high > pairHigh
                    pairHigh := high
                    pairHighKey := time
                    pairLow := outsideBase
                    pairLowKey := outsideStart
                    pairDirection := 1
                    candidateLow := pairLow
                    candidateLowKey := pairLowKey
                // High внешней свечи — последний максимум перед её падением.
                candidateHigh := high
                candidateHighKey := time
                if low < pairLow
                    pairLow := low
                    pairLowKey := time
                    pairHigh := candidateHigh
                    pairHighKey := candidateHighKey
                    pairDirection := -1
                    candidateLow := pairLow
                    candidateLowKey := pairLowKey
            else
                if low < pairLow
                    pairLow := low
                    pairLowKey := time
                    pairHigh := outsideBase
                    pairHighKey := outsideStart
                    pairDirection := -1
                    candidateHigh := pairHigh
                    candidateHighKey := pairHighKey
                candidateLow := low
                candidateLowKey := time
                if high > pairHigh
                    pairHigh := high
                    pairHighKey := time
                    pairLow := candidateLow
                    pairLowKey := candidateLowKey
                    pairDirection := 1
                    candidateHigh := pairHigh
                    candidateHighKey := pairHighKey
        else
            if newPivot
                if rawDir == -1 and (na(candidateHighKey) or pivotTime >= candidateHighKey)
                    candidateHigh := pivotPrice
                    candidateHighKey := pivotTime
                else if rawDir == 1 and (na(candidateLowKey) or pivotTime >= candidateLowKey)
                    candidateLow := pivotPrice
                    candidateLowKey := pivotTime
            if high > pairHigh
                pairHigh := high
                pairHighKey := time
                pairLow := candidateLow
                pairLowKey := candidateLowKey
                pairDirection := 1
                candidateHigh := pairHigh
                candidateHighKey := pairHighKey
            else if low < pairLow
                pairLow := low
                pairLowKey := time
                pairHigh := candidateHigh
                pairHighKey := candidateHighKey
                pairDirection := -1
                candidateLow := pairLow
                candidateLowKey := pairLowKey
    if newPivot
        seenPivot := pivotTime
        seenDir := rawDir
    [pairHigh, pairLow, pairHighKey, pairLowKey, pairDirection]

// Состояние рабочего FVG для сводки текущего инструмента.
// Оно не подменяет уровни, по которым проверяется сам захват.
type LiquidityView
    int side
    float top
    float bottom
    bool working
    int closedAt

type FlowLiquidity
    float structureHigh
    float structureLow
    int idmHighKey
    int idmLowKey
    float top
    float bottom
    int side
    bool working
    bool balanced
    float sourceClose
    int sourceClosedAt
    float closingSourceClose = na
    int closingSourceClosedAt = na
    int structureDirection = 0
    LiquidityView previousView = na
    LiquidityView closingView = na

// Уровни до пробоя сохраняются для событий захвата. Новое состояние и
// текущее закрытие передаются отдельно с временем доступности исходного ТФ.
f_exportLiquidity(FlowLiquidity level) =>
    FlowLiquidity previousLevel = level[1]
    FlowLiquidity result = na
    if not na(previousLevel)
        result := previousLevel.copy()
        result.closingSourceClose := close
        result.closingSourceClosedAt := time_close
        // Для сводки нужны направление, рабочие границы и время подтверждения.
        result.previousView := LiquidityView.new(previousLevel.side, previousLevel.top, previousLevel.bottom, previousLevel.working, previousLevel.sourceClosedAt)
        result.closingView := LiquidityView.new(level.side, level.top, level.bottom, level.working, time_close)
    result

// Публикация для потребителя: до закрытия исходного ТФ — прежнее состояние,
// на его закрытии — новое. Cutoff задаётся в контексте графика-потребителя.
f_confirmedLiquidity(FlowLiquidity level, int cutoff) =>
    LiquidityView result = na
    if not na(level) and not na(cutoff)
        LiquidityView previous = level.previousView
        if not na(previous)
            if not na(previous.closedAt) and previous.closedAt <= cutoff
                result := previous.copy()
        LiquidityView closing = level.closingView
        if not na(closing)
            if not na(closing.closedAt) and closing.closedAt <= cutoff and (na(result) or closing.closedAt >= result.closedAt)
                result := closing.copy()
    result

// История действующих событий одного старшего ТФ.
// Захват уровня пары не отменяется: более ранние записи больше не станут главными.
type LiquidityCapture
    int side
    int capturedAt
    string detail
    bool fromFvg
    float top
    float bottom

// Главное событие — последнее действующее; пробой FVG возвращает предыдущую запись.
f_flowLiquidityEvents(FlowLiquidity level, string tf) =>
    var string detail = ""
    var string lastRegistered = "не зарегистрировано"
    var string lastCancellation = "не было"
    var int eventSide = 0
    var int eventAt = na
    var array<LiquidityCapture> captureHistory = array.new<LiquidityCapture>()
    var int checkedSourceClose = na
    var int trackedHighKey = na
    var int trackedLowKey = na
    var bool highSwept = false
    var bool lowSwept = false
    var bool wasTouched = false
    var float touchedTop = na
    var float touchedBottom = na
    var int touchedSide = 0
    if not na(level)
        // Отмену подтверждает только закрытая свеча собственного ТФ зоны.
        // Проверяем и отложенные записи: пробитое событие не должно восстановиться.
        bool closingSourceAvailable = not na(time_close) and not na(level.closingSourceClosedAt) and level.closingSourceClosedAt <= time_close
        int rejectionClosedAt = closingSourceAvailable ? level.closingSourceClosedAt : level.sourceClosedAt
        float rejectionClose = closingSourceAvailable ? level.closingSourceClose : level.sourceClose
        if not na(rejectionClosedAt) and (na(checkedSourceClose) or rejectionClosedAt > checkedSourceClose)
            checkedSourceClose := rejectionClosedAt
            int historyIndex = array.size(captureHistory) - 1
            while historyIndex >= 0
                LiquidityCapture saved = array.get(captureHistory, historyIndex)
                bool rejected = saved.fromFvg and rejectionClosedAt > saved.capturedAt and (saved.side == 1 ? rejectionClose <= saved.bottom : rejectionClose >= saved.top)
                if rejected
                    lastCancellation := saved.detail + " отменено закрытием " + tf + " от " + str.format_time(rejectionClosedAt, "yyyy-MM-dd HH:mm", "Europe/Moscow")
                    array.remove(captureHistory, historyIndex)
                historyIndex -= 1
            eventSide := 0
            detail := ""
            eventAt := na
            if array.size(captureHistory) > 0
                LiquidityCapture restored = array.last(captureHistory)
                eventSide := restored.side
                detail := restored.detail
                eventAt := restored.capturedAt
        // Смена плеча, потока или балансировка сами по себе захват не отменяют.
        if not na(level.idmHighKey) and (na(trackedHighKey) or trackedHighKey != level.idmHighKey)
            trackedHighKey := level.idmHighKey
            highSwept := false
        if not na(level.idmLowKey) and (na(trackedLowKey) or trackedLowKey != level.idmLowKey)
            trackedLowKey := level.idmLowKey
            lowSwept := false
        bool sweptHigh = not highSwept and not na(level.structureHigh) and high > level.structureHigh
        bool sweptLow = not lowSwept and not na(level.structureLow) and low < level.structureLow
        if sweptHigh
            highSwept := true
        if sweptLow
            lowSwept := true
        // Касание границы не подтверждает: нужен хотя бы один тик внутри FVG.
        bool insideZone = high > level.bottom and low < level.top
        bool enteredOneTick = level.side == 1 ? math.round_to_mintick(low) <= math.round_to_mintick(level.top - syminfo.mintick) : math.round_to_mintick(high) >= math.round_to_mintick(level.bottom + syminfo.mintick)
        bool touched = level.working and level.side != 0 and insideZone and enteredOneTick
        // На свече подтверждённого пробоя старой зоны не создаём новый захват
        // по её ещё смещённым на один исходный бар границам.
        bool closingZoneRejected = closingSourceAvailable and (level.side == 1 ? rejectionClose <= level.bottom : rejectionClose >= level.top)
        bool newTouch = touched and not level.balanced and not closingZoneRejected and (not wasTouched or touchedTop != level.top or touchedBottom != level.bottom or touchedSide != level.side)
        bool longSignal = sweptLow or (newTouch and level.side == 1)
        bool shortSignal = sweptHigh or (newTouch and level.side == -1)
        // OHLC не определяет порядок противоположных событий внутри одной свечи.
        if longSignal and shortSignal
            lastCancellation := "Конфликт " + str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Moscow") + ": оба направления на одной свече; MIN=" + str.tostring(sweptLow) + ", MAX=" + str.tostring(sweptHigh) + ", заход FVG=" + str.tostring(newTouch) + "; прежнее: " + detail
            array.clear(captureHistory)
            eventSide := 0
            detail := ""
            eventAt := na
        else if longSignal or shortSignal
            if eventSide != 0
                lastCancellation := detail + " заменено новым захватом " + str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Moscow")
            eventSide := longSignal ? 1 : -1
            eventAt := time
            bool sweep = longSignal ? sweptLow : sweptHigh
            string sweptName = longSignal ? (level.structureDirection == -1 ? " MIN " : " IDM ") : (level.structureDirection == 1 ? " MAX " : " IDM ")
            string reason = sweep ? sweptName + str.tostring(longSignal ? level.structureLow : level.structureHigh, format.mintick) : " FVG " + (longSignal ? "ЛОНГ" : "ШОРТ") + " [" + str.tostring(level.bottom, format.mintick) + "; " + str.tostring(level.top, format.mintick) + "]"
            detail := tf + reason + " от " + str.format_time(time, "yyyy-MM-dd HH:mm", "Europe/Moscow") + "; "
            lastRegistered := detail
            if sweep
                // Захват MAX/MIN или IDM не отменяется и заслоняет предысторию.
                array.clear(captureHistory)
            array.push(captureHistory, LiquidityCapture.new(eventSide, eventAt, detail, not sweep, level.top, level.bottom))
        wasTouched := touched
        touchedTop := level.top
        touchedBottom := level.bottom
        touchedSide := level.side
    // Строку аудита собираем только при включённой диагностике: иначе это
    // лишняя работа на каждом баре в каждом регистре.
    string audit = ""
    if flowDiagnosticEnabled
        audit := "\n" + tf + " последнее событие: " + lastRegistered + "\n" + tf + " последняя отмена: " + lastCancellation
        audit += "\n" + tf + " рабочая пара: " + (na(level) ? "нет данных" : level.structureDirection == 1 ? "MAX " + str.tostring(level.structureHigh, format.mintick) + " | IDM " + str.tostring(level.structureLow, format.mintick) : "MIN " + str.tostring(level.structureLow, format.mintick) + " | IDM " + str.tostring(level.structureHigh, format.mintick))
    [eventSide == 1 ? detail : "", eventSide == -1 ? detail : "", audit, eventSide == 1 ? eventAt : int(na), eventSide == -1 ? eventAt : int(na)]

// Кандидаты обходятся от дальнего ТФ к ближнему: при равном времени берём ближний.
f_newerCapture(int candidateLong, int candidateShort, int selectedLong, int selectedShort) =>
    int candidateTime = na(candidateLong) ? candidateShort : candidateLong
    int selectedTime = na(selectedLong) ? selectedShort : selectedLong
    not na(candidateTime) and (na(selectedTime) or candidateTime >= selectedTime)

f_ruleOneState(int direction, bool broken, int candidate, bool required, int longTime, int shortTime, int brokenAt, int fvgAt) =>
    int eventTime = direction == -1 ? longTime : shortTime
    bool orderedBreak = broken and (not required or (not na(eventTime) and not na(brokenAt) and brokenAt >= eventTime))
    bool orderedFvg = not na(candidate) and (not required or (not na(eventTime) and not na(fvgAt) and fvgAt > eventTime))
    string result = "\nСЕЙЧАС №1: " + (direction == 0 ? "инициализация структуры" : direction == -1 ? "ожидание лонга" : "ожидание шорта")
    result += "\nФАКТ: первый FVG пробит: " + (broken ? "да" : "нет") + (na(brokenAt) ? "" : " от " + str.format_time(brokenAt, "yyyy-MM-dd HH:mm", "Europe/Moscow"))
    result += "\nФАКТ: встречный FVG: " + (not na(candidate) ? "да" : "нет") + (na(fvgAt) ? "" : " от " + str.format_time(fvgAt, "yyyy-MM-dd HH:mm", "Europe/Moscow"))
    result += "\nПОСЛЕ подтверждения: пробой=" + (orderedBreak ? "да" : "нет") + "; встречный FVG=" + (orderedFvg ? "да" : "нет")
    result += "\nСтаршее подтверждение: " + (not required ? "не требуется" : na(eventTime) ? "нет" : str.format_time(eventTime, "yyyy-MM-dd HH:mm", "Europe/Moscow"))
    result

f_flowSnapshot(bool requireLiquidity, string longEvent, string shortEvent, string higherAudit, int longCaptureTime, int shortCaptureTime, bool exportLevel) =>
    [rawDir, rawStart, rawBase, rawTip, rawOutsideDir, rawOutsideStart, rawOutsideBase, rawStartBar, rawTipBar, rawOutsideStartBar, rawTipTime] = f_mtfFlow()
    [legDir, legStart, legBase, legTip, legTipTime] = f_orderMovement(rawDir, rawStart, rawBase, rawTip, rawStartBar, rawTipBar, rawTipTime)
    var array<MtfFvg> zones = array.new<MtfFvg>()
    var array<int> activeZoneIndices = array.new_int()
    var array<PendingFlowFvg> pendingFvgs = array.new<PendingFlowFvg>()
    var array<RuleOneFvg> ruleOneCandidates = array.new<RuleOneFvg>()
    var int flowDir = 0
    var float flowLo = na
    var float flowHi = na
    var int flowStart = na
    var int flowSeedImpulse = na
    var bool flowOriginLocked = false
    var bool flowHasFvg = false
